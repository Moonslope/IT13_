@page "/inventory/purchase-orders"
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Infrastructure
@inject IDbContextFactory<HestiaLinkContext> ContextFactory
@inject InventoryService InventoryService
@inject IJSRuntime JSRuntime
@layout HestiaIT13Final.Components.Layout.MainLayout

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Purchase Orders</h1>
            <span class="page-topbar-subtitle">Inventory Purchasing</span>
        </div>
        <UserDropdown />
    </header>

    <div class="page-content">
        <div class="user-toolbar">
            <div class="toolbar-left">
                <div class="toolbar-search">
                    <input type="text" placeholder="Search by purchase number or item..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <select class="filter-select" @bind="FilterStatus">
                    <option value="All">All Orders</option>
                    <option value="PENDING">Pending</option>
                    <option value="RECEIVED">Received</option>
                    <option value="CANCELLED">Cancelled</option>
                </select>
            </div>
            <div>
                <button class="btn-create" @onclick="OpenModal">Create New Purchase Order</button>
            </div>
        </div>

        @if (!IsLoaded)
        {
            <div class="loading">Loading purchase orders...</div>
        }
        else if (HasError)
        {
            <div class="error-message">
                <h4>⚠️ Error</h4>
                <p>@ErrorMessage</p>
                <button class="btn-primary" @onclick="RetryLoad">Retry</button>
            </div>
        }
        else
        {
            <div class="panel-card">
                <div class="panel-body user-list-container">
                    @if (FilteredPurchases.Any())
                    {
                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th style="text-align:center;">Purchase #</th>
                                    <th style="text-align:center;">Item</th>
                                    <th style="text-align:center;">Supplier</th>
                                    <th style="text-align:center;">Quantity</th>
                                    <th style="text-align:center;">Unit Price</th>
                                    <th style="text-align:center;">Total Amount</th>
                                    <th style="text-align:center;">Purchase Date</th>
                                    <th style="text-align:center;">Received Date</th>
                                    <th style="text-align:center;">Status</th>
                                    <th style="text-align:center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var purchase in PaginatedPurchases)
                                {
                                    <tr>
                                        <td style="font-family:monospace; font-weight:700; text-align:center;">@purchase.PurchaseNumber</td>
                                        <td style="font-weight:600; text-align:center;">@(purchase.InventoryItem?.ItemName ?? "N/A")</td>
                                        <td style="text-align:center;">@(purchase.Supplier?.SupplierName ?? "N/A")</td>
                                        <td style="text-align:center;">@purchase.Quantity</td>
                                        <td style="text-align:center;">@purchase.UnitPrice.ToString("C")</td>
                                        <td style="text-align:center; font-weight:700;">@(purchase.TotalAmount?.ToString("C") ?? "-")</td>
                                        <td style="text-align:center;">@(purchase.PurchaseDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td style="text-align:center;">@(purchase.ReceivedDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                                        <td style="text-align:center;">
                                            @if (purchase.PurchaseStatus == "RECEIVED")
                                            {
                                                <span class="badge-active">Received</span>
                                            }
                                            else if (purchase.PurchaseStatus == "PENDING")
                                            {
                                                <span class="badge-pending">Pending</span>
                                            }
                                            else
                                            {
                                                <span class="badge-archived">@purchase.PurchaseStatus</span>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            <div style="display:flex; justify-content:center; gap:8px; align-items:center;">
                                                @if (purchase.PurchaseStatus == "PENDING")
                                                {
                                                    <button class="btn-icon-action edit" @onclick="() => OpenEditModal(purchase)" title="Edit">
                                                        <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                                    </button>
                                                    <button class="btn-icon-action edit" style="background:#10b981;" @onclick="() => ReceivePurchase(purchase)" title="Mark as Received">
                                                        <svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
                                                    </button>
                                                    <button class="btn-icon-action archive" @onclick="() => CancelPurchase(purchase)" title="Cancel">
                                                        <svg viewBox="0 0 24 24"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (FilteredPurchases.Count > 0)
                        {
                            <Pagination CurrentPage="@CurrentPage" 
                                        TotalItems="@FilteredPurchases.Count" 
                                        ItemsPerPage="@ItemsPerPage"
                                        OnPageChanged="@OnPageChanged"
                                        OnItemsPerPageChangedCallback="@OnItemsPerPageChanged" />
                        }
                    }
                    else
                    {
                        <div class="no-data">No purchase orders found</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 800px;">
            <div class="modal-header-teal">
                <h2 style="margin:0; font-size:1.4rem;">@(IsEditMode ? "Edit Purchase Order" : "Create New Purchase Order")</h2>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Inventory Item *</label>
                    <select class="form-select" value="@CurrentPurchase.ItemID" @onchange="OnItemChanged">
                        <option value="0">-- Select Item --</option>
                        @foreach (var item in InventoryItems)
                        {
                            <option value="@item.ItemId">@item.ItemName (@item.ItemCode)</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Supplier</label>
                    <select class="form-select" @bind="CurrentPurchase.SupplierID">
                        <option value="">-- Select Supplier --</option>
                        @foreach (var supplier in Suppliers)
                        {
                            <option value="@supplier.SupplierID">@supplier.SupplierName</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Quantity *</label>
                    <input type="number" class="form-input" value="@CurrentPurchase.Quantity" @onchange="OnQuantityChanged" />
                </div>
                <div class="form-group">
                    <label class="form-label">Unit Price *</label>
                    <input type="number" step="0.01" class="form-input" value="@CurrentPurchase.UnitPrice" @onchange="OnUnitPriceChanged" />
                </div>

                <div class="form-group">
                    <label class="form-label">Total Amount</label>
                    <input type="text" class="form-input" value="@(CurrentPurchase.TotalAmount?.ToString("C") ?? "0.00")" readonly />
                </div>
                <div class="form-group">
                    <label class="form-label">Purchase Date</label>
                    <input type="date" class="form-input" @bind="PurchaseDate" />
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Notes</label>
                    <textarea class="form-input" @bind="CurrentPurchase.Notes" rows="3"></textarea>
                </div>
            </div>

            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" @onclick="SavePurchase">@(IsEditMode ? "Update Purchase Order" : "Create Purchase Order")</button>
                <button class="btn-secondary" @onclick="CloseModal">Cancel</button>
            </div>
        </div>
    </div>
}

@if (ShowConfirmModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 400px;">
            <div class="modal-header-teal" style="background-color: var(--color-danger, #ef4444);">
                <h2 style="margin:0; font-size:1.2rem; color: white;">Confirm Action</h2>
            </div>
            <div style="padding: 24px;">
                <p style="margin: 0; font-size: 1rem; color: #374151;">@ConfirmMessage</p>
            </div>
            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" style="background-color: var(--color-danger, #ef4444);" @onclick="ConfirmAction">Confirm</button>
                <button class="btn-secondary" @onclick="CloseConfirmModal">Cancel</button>
            </div>
        </div>
    </div>
}

@if (ShowAlertModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 400px;">
            <div class="modal-header-teal">
                <h2 style="margin:0; font-size:1.2rem; color: white;">Notification</h2>
            </div>
            <div style="padding: 24px;">
                <p style="margin: 0; font-size: 1rem; color: #374151;">@AlertMessage</p>
            </div>
            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" @onclick="CloseAlertModal">OK</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchText = "";
    private string FilterStatus = "All";
    private bool ShowModal = false;
    private bool IsEditMode = false;
    private bool IsLoaded = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    // Confirmation Modal
    private bool ShowConfirmModal = false;
    private string ConfirmMessage = "";
    private InventoryPurchase? PurchaseToProcess;
    private enum ConfirmActionType { None, Receive, Cancel }
    private ConfirmActionType CurrentActionType = ConfirmActionType.None;

    // Alert Modal
    private bool ShowAlertModal = false;
    private string AlertMessage = "";

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage = 10;

    private InventoryPurchase CurrentPurchase = new();
    private List<InventoryPurchase> Purchases = new();
    private List<InventoryItem> InventoryItems = new();
    private List<Supplier> Suppliers = new();
    private DateTime PurchaseDate = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            HasError = false;
            ErrorMessage = string.Empty;

            using var context = ContextFactory.CreateDbContext();
            
            Purchases = await context.InventoryPurchases
                .Include(p => p.InventoryItem)
                .Include(p => p.Supplier)
                .AsNoTracking()
                .OrderByDescending(p => p.PurchaseDate)
                .ToListAsync();

            InventoryItems = await context.InventoryItems
                .Where(i => i.IsActive == true)
                .AsNoTracking()
                .OrderBy(i => i.ItemName)
                .ToListAsync();

            Suppliers = await context.Suppliers
                .Where(s => s.IsActive == true)
                .AsNoTracking()
                .OrderBy(s => s.SupplierName)
                .ToListAsync();

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            ShowAlert($"Database Error: {ex.Message}");
            IsLoaded = true;
        }
    }

    private async Task RetryLoad()
    {
        IsLoaded = false;
        StateHasChanged();
        await Task.Delay(500);
        await LoadData();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
        StateHasChanged();
    }

    private List<InventoryPurchase> FilteredPurchases
    {
        get
        {
            var list = Purchases.ToList();

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search = SearchText.Trim();
                list = list.Where(p =>
                    p.PurchaseNumber.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (p.InventoryItem?.ItemName ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (FilterStatus != "All")
                list = list.Where(p => p.PurchaseStatus == FilterStatus).ToList();

            return list.OrderByDescending(p => p.PurchaseDate).ToList();
        }
    }

    private List<InventoryPurchase> PaginatedPurchases
    {
        get
        {
            var filtered = FilteredPurchases;
            return filtered.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage).ToList();
        }
    }

    private void OnPageChanged(int page)
    {
        CurrentPage = page;
        StateHasChanged();
    }

    private void OnItemsPerPageChanged(int itemsPerPage)
    {
        ItemsPerPage = itemsPerPage;
        CurrentPage = 1;
        StateHasChanged();
    }

    private void OpenModal()
    {
        CurrentPurchase = new InventoryPurchase 
        { 
            PurchaseStatus = "PENDING",
            PurchaseDate = DateTime.Now,
            CreatedDate = DateTime.Now
        };
        PurchaseDate = DateTime.Now;
        IsEditMode = false;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; }

    private void OpenEditModal(InventoryPurchase purchase)
    {
        CurrentPurchase = new InventoryPurchase
        {
            PurchaseID = purchase.PurchaseID,
            PurchaseNumber = purchase.PurchaseNumber,
            ItemID = purchase.ItemID,
            SupplierID = purchase.SupplierID,
            Quantity = purchase.Quantity,
            UnitPrice = purchase.UnitPrice,
            TotalAmount = purchase.TotalAmount,
            PurchaseDate = purchase.PurchaseDate,
            Notes = purchase.Notes,
            PurchaseStatus = purchase.PurchaseStatus
        };
        PurchaseDate = purchase.PurchaseDate ?? DateTime.Now;
        IsEditMode = true;
        ShowModal = true;
    }

    private void OnItemChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int itemId) && itemId > 0)
        {
            CurrentPurchase.ItemID = itemId;
            var item = InventoryItems.FirstOrDefault(i => i.ItemId == itemId);
            if (item != null && CurrentPurchase.SupplierID == null)
            {
                CurrentPurchase.SupplierID = item.SupplierID;
            }
        }
        CalculateTotal();
    }

    private void OnQuantityChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int quantity))
        {
            CurrentPurchase.Quantity = quantity;
            CalculateTotal();
        }
    }

    private void OnUnitPriceChanged(ChangeEventArgs e)
    {
        if (decimal.TryParse(e.Value?.ToString(), out decimal unitPrice))
        {
            CurrentPurchase.UnitPrice = unitPrice;
            CalculateTotal();
        }
    }

    private void CalculateTotal()
    {
        CurrentPurchase.CalculateTotal();
        StateHasChanged();
    }

    private async Task SavePurchase()
    {
        try
        {
            if (CurrentPurchase.ItemID == 0 || CurrentPurchase.Quantity <= 0 || CurrentPurchase.UnitPrice <= 0)
            {
                ShowAlert("Please fill in all required fields with valid values.");
                return;
            }

            CurrentPurchase.PurchaseDate = PurchaseDate;
            CurrentPurchase.CalculateTotal();

            if (IsEditMode)
            {
                await InventoryService.UpdatePurchaseAsync(CurrentPurchase);
            }
            else
            {
                await InventoryService.CreatePurchaseOrderAsync(CurrentPurchase);
            }

            CloseModal();
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error saving purchase order: {ex.Message}");
        }
    }

    private void ReceivePurchase(InventoryPurchase purchase)
    {
        PurchaseToProcess = purchase;
        CurrentActionType = ConfirmActionType.Receive;
        ConfirmMessage = $"Mark purchase order {purchase.PurchaseNumber} as received? This will update inventory stock.";
        ShowConfirmModal = true;
    }

    private void CancelPurchase(InventoryPurchase purchase)
    {
        PurchaseToProcess = purchase;
        CurrentActionType = ConfirmActionType.Cancel;
        ConfirmMessage = $"Cancel purchase order {purchase.PurchaseNumber}?";
        ShowConfirmModal = true;
    }

    private async Task ConfirmAction()
    {
        if (PurchaseToProcess != null)
        {
            if (CurrentActionType == ConfirmActionType.Receive)
            {
                await InventoryService.ReceivePurchaseAsync(PurchaseToProcess.PurchaseID);
            }
            else if (CurrentActionType == ConfirmActionType.Cancel)
            {
                await InventoryService.CancelPurchaseAsync(PurchaseToProcess.PurchaseID);
            }
            await LoadData();
            StateHasChanged();
        }
        CloseConfirmModal();
    }

    private void CloseConfirmModal()
    {
        ShowConfirmModal = false;
        PurchaseToProcess = null;
        CurrentActionType = ConfirmActionType.None;
    }

    private void ShowAlert(string message)
    {
        AlertMessage = message;
        ShowAlertModal = true;
    }

    private void CloseAlertModal()
    {
        ShowAlertModal = false;
    }
}

