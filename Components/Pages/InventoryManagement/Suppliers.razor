@page "/inventory/suppliers"
@using Microsoft.EntityFrameworkCore
@using Microsoft.EntityFrameworkCore.Infrastructure
@inject IDbContextFactory<HestiaLinkContext> ContextFactory
@inject InventoryService InventoryService
@inject IJSRuntime JSRuntime
@layout HestiaIT13Final.Components.Layout.MainLayout

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Suppliers</h1>
            <span class="page-topbar-subtitle">Vendor Management</span>
        </div>
        <UserDropdown />
    </header>

    <div class="page-content">
        <div class="user-toolbar">
            <div class="toolbar-left">
                <div class="toolbar-search">
                    <input type="text" placeholder="Search by name, code, or contact..." @bind="SearchText" @oninput="OnSearchChanged" />
                </div>
                <select class="filter-select" @bind="FilterStatus">
                    <option value="All">All Suppliers</option>
                    <option value="Active">Active Only</option>
                    <option value="Inactive">Inactive Only</option>
                </select>
            </div>
            <div>
                <button class="btn-create" @onclick="OpenModal">Create New Supplier</button>
            </div>
        </div>

        @if (!IsLoaded)
        {
            <div class="loading">Loading suppliers...</div>
        }
        else if (HasError)
        {
            <div class="error-message">
                <h4>⚠️ Error</h4>
                <p>@ErrorMessage</p>
                <button class="btn-primary" @onclick="RetryLoad">Retry</button>
            </div>
        }
        else
        {
            <div class="panel-card">
                <div class="panel-body user-list-container">
                    @if (FilteredSuppliers.Any())
                    {
                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th>Supplier Code</th>
                                    <th>Supplier Name</th>
                                    <th>Contact Person</th>
                                    <th>Phone</th>
                                    <th>Email</th>
                                    <th>Type</th>
                                    <th>Status</th>
                                    <th style="text-align:center;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var supplier in PaginatedSuppliers)
                                {
                                    <tr>
                                        <td style="font-family:monospace; font-weight:700;">@supplier.SupplierCode</td>
                                        <td style="font-weight:600;">@supplier.SupplierName</td>
                                        <td>@(supplier.ContactPerson ?? "-")</td>
                                        <td>@(supplier.ContactPhone ?? "-")</td>
                                        <td>@(supplier.ContactEmail ?? "-")</td>
                                        <td>@(supplier.SupplierType ?? "-")</td>
                                        <td>
                                            @if ((supplier.IsActive ?? false))
                                            {
                                                <span class="badge-active">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge-archived">Inactive</span>
                                            }
                                        </td>
                                        <td style="text-align:center;">
                                            <div style="display:flex; justify-content:center; gap:8px; align-items:center;">
                                                <button class="btn-icon-action edit" @onclick="() => OpenEditModal(supplier)" title="Edit">
                                                    <svg viewBox="0 0 24 24"><path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z"/></svg>
                                                </button>
                                                @if (supplier.IsActive == true)
                                                {
                                                    <button class="btn-icon-action archive" @onclick="() => DeactivateSupplier(supplier)" title="Deactivate">
                                                        <svg viewBox="0 0 24 24"><path d="M20.54 5.23l-1.39-1.68C18.88 3.21 18.47 3 18 3H6c-.47 0-.88.21-1.16.55L3.46 5.23C3.17 5.57 3 6.02 3 6.5V19c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V6.5c0-.48-.17-.93-.46-1.27zM6.24 5h11.52l.81.97H5.44l.8-.97zM5 19V8h14v11H5zm8.45-9h-2.9v3H8l4 4 4-4h-2.55z"/></svg>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn-icon-action edit" @onclick="() => ActivateSupplier(supplier)" title="Activate">
                                                        <svg viewBox="0 0 24 24"><path d="M9 16.2L4.8 12l-1.4 1.4L9 19 21 7l-1.4-1.4L9 16.2z"/></svg>
                                                    </button>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        @if (FilteredSuppliers.Count > 0)
                        {
                            <Pagination CurrentPage="@CurrentPage" 
                                        TotalItems="@FilteredSuppliers.Count" 
                                        ItemsPerPage="@ItemsPerPage"
                                        OnPageChanged="@OnPageChanged"
                                        OnItemsPerPageChangedCallback="@OnItemsPerPageChanged" />
                        }
                    }
                    else
                    {
                        <div class="no-data">No suppliers found</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@if (ShowModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 800px;">
            <div class="modal-header-teal">
                <h2 style="margin:0; font-size:1.4rem;">@(IsEditMode ? "Edit Supplier" : "Create New Supplier")</h2>
            </div>

            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Supplier Code *</label>
                    <input type="text" class="form-input" @bind="CurrentSupplier.SupplierCode" />
                </div>
                <div class="form-group">
                    <label class="form-label">Supplier Name *</label>
                    <input type="text" class="form-input" @bind="CurrentSupplier.SupplierName" />
                </div>

                <div class="form-group">
                    <label class="form-label">Contact Person</label>
                    <input type="text" class="form-input" @bind="CurrentSupplier.ContactPerson" />
                </div>
                <div class="form-group">
                    <label class="form-label">Contact Phone</label>
                    <input type="text" class="form-input" @bind="CurrentSupplier.ContactPhone" />
                </div>

                <div class="form-group">
                    <label class="form-label">Contact Email</label>
                    <input type="email" class="form-input" @bind="CurrentSupplier.ContactEmail" />
                </div>
                <div class="form-group">
                    <label class="form-label">Supplier Type</label>
                    <select class="form-select" @bind="CurrentSupplier.SupplierType">
                        <option value="">-- Select Type --</option>
                        <option value="FOOD">Food</option>
                        <option value="BEVERAGE">Beverage</option>
                        <option value="AMENITIES">Amenities</option>
                        <option value="CLEANING">Cleaning</option>
                        <option value="LINEN">Linen</option>
                        <option value="OTHER">Other</option>
                    </select>
                </div>

                <div class="form-group full-width">
                    <label class="form-label">Address</label>
                    <textarea class="form-input" @bind="CurrentSupplier.Address" rows="3"></textarea>
                </div>
            </div>

            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" @onclick="SaveSupplier">@(IsEditMode ? "Update Supplier" : "Create Supplier")</button>
                <button class="btn-secondary" @onclick="CloseModal">Cancel</button>
            </div>
        </div>
    </div>
}

@if (ShowConfirmModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 400px;">
            <div class="modal-header-teal" style="background-color: var(--color-danger, #ef4444);">
                <h2 style="margin:0; font-size:1.2rem; color: white;">Confirm Action</h2>
            </div>
            <div style="padding: 24px;">
                <p style="margin: 0; font-size: 1rem; color: #374151;">@ConfirmMessage</p>
            </div>
            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" style="background-color: var(--color-danger, #ef4444);" @onclick="ConfirmAction">Confirm</button>
                <button class="btn-secondary" @onclick="CancelAction">Cancel</button>
            </div>
        </div>
    </div>
}

@if (ShowAlertModal)
{
    <div class="modal-overlay">
        <div class="modal-content" style="max-width: 400px;">
            <div class="modal-header-teal">
                <h2 style="margin:0; font-size:1.2rem; color: white;">Notification</h2>
            </div>
            <div style="padding: 24px;">
                <p style="margin: 0; font-size: 1rem; color: #374151;">@AlertMessage</p>
            </div>
            <div class="action-footer" style="border:none; padding-bottom:0; margin-top:10px;">
                <button class="btn-primary" @onclick="CloseAlertModal">OK</button>
            </div>
        </div>
    </div>
}

@code {
    private string SearchText = "";
    private string FilterStatus = "Active";
    private bool ShowModal = false;
    private bool IsEditMode = false;
    private bool IsLoaded = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    // Confirmation Modal
    private bool ShowConfirmModal = false;
    private string ConfirmMessage = "";
    private Supplier? SupplierToDeactivate;

    // Alert Modal
    private bool ShowAlertModal = false;
    private string AlertMessage = "";

    // Pagination
    private int CurrentPage = 1;
    private int ItemsPerPage = 10;

    private Supplier CurrentSupplier = new();
    private List<Supplier> SuppliersList = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            HasError = false;
            ErrorMessage = string.Empty;

            using var context = ContextFactory.CreateDbContext();
            
            SuppliersList = await context.Suppliers
                .AsNoTracking()
                .OrderBy(s => s.SupplierName)
                .ToListAsync();

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            ShowAlert($"Database Error: {ex.Message}");
            IsLoaded = true;
        }
    }

    private async Task RetryLoad()
    {
        IsLoaded = false;
        StateHasChanged();
        await Task.Delay(500);
        await LoadData();
    }

    private void OnSearchChanged(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? string.Empty;
        CurrentPage = 1;
        StateHasChanged();
    }

    private List<Supplier> FilteredSuppliers
    {
        get
        {
            var list = SuppliersList.ToList();

            if (!string.IsNullOrWhiteSpace(SearchText))
            {
                var search = SearchText.Trim();
                list = list.Where(s =>
                    s.SupplierCode.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    s.SupplierName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (s.ContactPerson ?? "").Contains(search, StringComparison.OrdinalIgnoreCase) ||
                    (s.ContactEmail ?? "").Contains(search, StringComparison.OrdinalIgnoreCase)).ToList();
            }

            if (FilterStatus == "Active")
                list = list.Where(s => s.IsActive == true).ToList();
            else if (FilterStatus == "Inactive")
                list = list.Where(s => s.IsActive != true).ToList();

            return list.OrderBy(s => s.SupplierName).ToList();
        }
    }

    private List<Supplier> PaginatedSuppliers
    {
        get
        {
            var filtered = FilteredSuppliers;
            return filtered.Skip((CurrentPage - 1) * ItemsPerPage).Take(ItemsPerPage).ToList();
        }
    }

    private void OnPageChanged(int page)
    {
        CurrentPage = page;
        StateHasChanged();
    }

    private void OnItemsPerPageChanged(int itemsPerPage)
    {
        ItemsPerPage = itemsPerPage;
        CurrentPage = 1;
        StateHasChanged();
    }

    private async Task OpenModal()
    {
        CurrentSupplier = new Supplier 
        { 
            IsActive = true,
            SupplierCode = await InventoryService.GenerateSupplierCodeAsync(),
            CreatedDate = DateTime.Now
        };
        IsEditMode = false;
        ShowModal = true;
    }

    private void CloseModal() { ShowModal = false; }

    private void OpenEditModal(Supplier supplier)
    {
        CurrentSupplier = new Supplier
        {
            SupplierID = supplier.SupplierID,
            SupplierCode = supplier.SupplierCode,
            SupplierName = supplier.SupplierName,
            ContactPerson = supplier.ContactPerson,
            ContactPhone = supplier.ContactPhone,
            ContactEmail = supplier.ContactEmail,
            Address = supplier.Address,
            SupplierType = supplier.SupplierType,
            IsActive = supplier.IsActive
        };
        IsEditMode = true;
        ShowModal = true;
    }

    private async Task SaveSupplier()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(CurrentSupplier.SupplierCode) || string.IsNullOrWhiteSpace(CurrentSupplier.SupplierName))
            {
                ShowAlert("Please fill in all required fields.");
                return;
            }

            if (IsEditMode)
            {
                await InventoryService.UpdateSupplierAsync(CurrentSupplier);
            }
            else
            {
                await InventoryService.CreateSupplierAsync(CurrentSupplier);
            }

            CloseModal();
            await LoadData();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ShowAlert($"Error saving supplier: {ex.Message}");
        }
    }

    private void DeactivateSupplier(Supplier supplier)
    {
        SupplierToDeactivate = supplier;
        ConfirmMessage = $"Are you sure you want to deactivate {supplier.SupplierName}?";
        ShowConfirmModal = true;
    }

    private async Task ConfirmAction()
    {
        if (SupplierToDeactivate != null)
        {
            await InventoryService.DeactivateSupplierAsync(SupplierToDeactivate.SupplierID);
            await LoadData();
            StateHasChanged();
        }
        ShowConfirmModal = false;
        SupplierToDeactivate = null;
    }

    private void CancelAction()
    {
        ShowConfirmModal = false;
        SupplierToDeactivate = null;
    }

    private void ShowAlert(string message)
    {
        AlertMessage = message;
        ShowAlertModal = true;
    }

    private void CloseAlertModal()
    {
        ShowAlertModal = false;
    }

    private async Task ActivateSupplier(Supplier supplier)
    {
        await InventoryService.ReactivateSupplierAsync(supplier.SupplierID);
        await LoadData();
        StateHasChanged();
    }
}

