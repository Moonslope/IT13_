@code {
    private string SelectedPeriod = "month";
    private DateTime StartDate = DateTime.Now.AddMonths(-1);
    private DateTime EndDate = DateTime.Now;
    private string ActiveTab = "revenue";

    private List<Bill> BillSummary = new();
    private List<Payment> PaymentHistory = new();
    
    // Pagination for Payment History
    private int CurrentPaymentPage = 1;
    private int PaymentsPerPage = 10;
    private int TotalPaymentPages => (int)Math.Ceiling((double)PaymentHistory.Count / PaymentsPerPage);
    private List<Payment> PaginatedPayments => PaymentHistory
        .Skip((CurrentPaymentPage - 1) * PaymentsPerPage)
        .Take(PaymentsPerPage)
        .ToList();

    private void OnPaymentPageChanged(int page)
    {
        if (page >= 1 && page <= TotalPaymentPages)
        {
            CurrentPaymentPage = page;
        }
    }

    private void OnPaymentsPerPageChanged(int itemsPerPage)
    {
        PaymentsPerPage = itemsPerPage;
        CurrentPaymentPage = 1;
    }

    private decimal TotalRevenue => BillSummary?.Sum(b => b.GrandTotal ?? 0) ?? 0;
    private decimal TotalPayments => PaymentHistory?.Sum(p => p.Amount ?? 0) ?? 0;
    private decimal TotalOutstanding => BillSummary?.Where(b => b.BillStatus != "Paid").Sum(b => b.BalanceDue ?? 0) ?? 0;

    // Calculate VAT and Service Charge from paid bills' subtotals
    private decimal PaidSubtotal => BillSummary.Where(b => b.BillStatus == "Paid").Sum(b => b.SubtotalAmount ?? 0);
    private decimal VATCollected => PaidSubtotal * 0.12m;
    private decimal ServiceChargeCollected => PaidSubtotal * 0.10m;
    private decimal TotalTaxCollected => VATCollected + ServiceChargeCollected;
    private decimal PayrollTaxWithheld = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportData();
    }

    private bool _chartRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Only render chart once when on revenue tab with data
        if (ActiveTab == "revenue" && BillSummary.Any() && !_chartRendered)
        {
            _chartRendered = true;
            var collected = (double)BillSummary.Sum(b => b.AmountPaid ?? 0);
            var outstanding = (double)TotalOutstanding;
            
            try
            {
                await JSRuntime.InvokeVoidAsync("chartHelper.renderDoughnutChart",
                    "revenueChart",
                    new[] { "Collected", "Outstanding" },
                    new[] { collected, outstanding },
                    new[] { "#047857", "#991b1b" });
            }
            catch { /* Chart element may not exist yet */ }
        }
        else if (ActiveTab != "revenue")
        {
            _chartRendered = false; // Reset when leaving revenue tab
        }
    }

    private void OnPeriodChanged()
    {
        var now = DateTime.Now;
        switch (SelectedPeriod)
        {
            case "today":
                StartDate = now.Date;
                EndDate = now.Date;
                break;
            case "week":
                StartDate = now.AddDays(-(int)now.DayOfWeek);
                EndDate = now;
                break;
            case "month":
                StartDate = new DateTime(now.Year, now.Month, 1);
                EndDate = now;
                break;
            case "quarter":
                int quarter = (now.Month - 1) / 3;
                StartDate = new DateTime(now.Year, quarter * 3 + 1, 1);
                EndDate = now;
                break;
            case "year":
                StartDate = new DateTime(now.Year, 1, 1);
                EndDate = now;
                break;
        }
    }

    private void ChangeTab(string tab) => ActiveTab = tab;

    private async Task GenerateReport() => await LoadReportData();

    private async Task LoadReportData()
    {
        try
        {
            _chartRendered = false; // Reset so chart re-renders with new data
            CurrentPaymentPage = 1; // Reset pagination
            
            // Load Bills with Reservation and Guest navigation
            BillSummary = await _context.Bills
                .Include(b => b.Reservation!)
                    .ThenInclude(r => r!.Guest)
                .Where(b => b.BillDate >= StartDate && b.BillDate <= EndDate)
                .OrderByDescending(b => b.BillDate)
                .ToListAsync();

            // Load Payments
            PaymentHistory = await _context.Payments
                .Where(p => p.PaymentDate >= StartDate && p.PaymentDate <= EndDate)
                .OrderByDescending(p => p.PaymentDate)
                .ToListAsync();

            // Load Payroll Tax
            var payrolls = await _context.Payrolls
                .Where(p => p.PeriodEnd >= DateOnly.FromDateTime(StartDate) && 
                            p.PeriodEnd <= DateOnly.FromDateTime(EndDate))
                .ToListAsync();
            PayrollTaxWithheld = payrolls.Sum(p => p.TaxAmount ?? 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading report data: {ex.Message}");
        }
    }

    private async Task PrintReport()
    {
        await JSRuntime.InvokeVoidAsync("window.print");
    }

    private async Task ExportExcel()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("Financial Report");
        csv.AppendLine($"Period: {StartDate:yyyy-MM-dd} to {EndDate:yyyy-MM-dd}");
        csv.AppendLine();
        csv.AppendLine("REVENUE SUMMARY");
        csv.AppendLine("Invoice ID,Guest Name,Bill Date,Subtotal,Total,Paid,Balance,Status");
        
        foreach (var bill in BillSummary)
        {
            var guestName = GetGuestName(bill).Replace(",", " ");
            var subtotal = (bill.SubtotalAmount ?? 0).ToString("F2");
            var total = (bill.GrandTotal ?? 0).ToString("F2");
            var paid = (bill.AmountPaid ?? 0).ToString("F2");
            var balance = (bill.BalanceDue ?? 0).ToString("F2");
            csv.AppendLine($"INV-{bill.BillId:D5},{guestName},{bill.BillDate:yyyy-MM-dd},{subtotal},{total},{paid},{balance},{bill.BillStatus}");
        }
        
        csv.AppendLine();
        csv.AppendLine($"Total Revenue,{TotalRevenue.ToString("F2")}");
        csv.AppendLine($"Total Payments,{TotalPayments.ToString("F2")}");
        csv.AppendLine($"VAT Collected (Est),{VATCollected.ToString("F2")}");
        csv.AppendLine($"Service Charge (Est),{ServiceChargeCollected.ToString("F2")}");

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JSRuntime.InvokeVoidAsync("downloadFile", $"Financial_Report_{DateTime.Now:yyyyMMdd}.csv", base64, "text/csv");
    }

    private string GetGuestName(Bill bill)
    {
        var guest = bill.Reservation?.Guest;
        if (guest == null) return "N/A";
        return $"{guest.FirstName} {guest.LastName}";
    }
}
