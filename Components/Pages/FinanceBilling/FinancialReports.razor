@page "/finance/financial-reports"
@layout MainLayout
@using HestiaLink.Data
@using HestiaLink.Models
@using Microsoft.EntityFrameworkCore
@inject HestiaLinkContext _context
@inject IJSRuntime JSRuntime

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Financial Reports</h1>
            <span class="page-topbar-subtitle">Revenue & Tax Analytics</span>
        </div>
        <UserDropdown />
    </header>

    <section class="page-content">
        <!-- Filter Section -->
        <div class="filter-bar">
            <div class="filter-group">
                <label>Period</label>
                <select class="form-select" @bind="SelectedPeriod" @bind:after="OnPeriodChanged">
                    <option value="today">Today</option>
                    <option value="week">This Week</option>
                    <option value="month">This Month</option>
                    <option value="quarter">This Quarter</option>
                    <option value="year">This Year</option>
                    <option value="custom">Custom</option>
                </select>
            </div>
            <div class="filter-group">
                <label>From</label>
                <input type="date" class="form-input" @bind="StartDate" />
            </div>
            <div class="filter-group">
                <label>To</label>
                <input type="date" class="form-input" @bind="EndDate" />
            </div>
            <button class="btn-filter" @onclick="GenerateReport">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="22,3 2,3 10,12.46 10,19 14,21 14,12.46"></polygon>
                </svg>
                Filter
            </button>
            <div style="flex: 1;"></div>
            <button class="btn-export" @onclick="ExportExcel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                    <polyline points="7 10 12 15 17 10"></polyline>
                    <line x1="12" y1="15" x2="12" y2="3"></line>
                </svg>
                Export
            </button>
        </div>

        <!-- Key Financial Metrics - Dashboard Style -->
        <div class="dashboard-hero" style="margin-bottom:32px;">
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                </div>
                <div class="hero-stat-value">&#8369;@TotalRevenue.ToString("N2")</div>
                <div class="hero-stat-label">Total Revenue</div>
                <div class="hero-stat-change">@BillSummary.Count Transactions</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg>
                </div>
                <div class="hero-stat-value">&#8369;@TotalPayments.ToString("N2")</div>
                <div class="hero-stat-label">Total Payments</div>
                <div class="hero-stat-change">Amount collected</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                </div>
                <div class="hero-stat-value" style="color: rgba(255,255,255,0.95);">&#8369;@TotalOutstanding.ToString("N2")</div>
                <div class="hero-stat-label">Outstanding</div>
                <div class="hero-stat-change">Pending collection</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z"/></svg>
                </div>
                <div class="hero-stat-value">&#8369;@TotalTaxCollected.ToString("N2")</div>
                <div class="hero-stat-label">Tax Collected</div>
                <div class="hero-stat-change">VAT + Service Charge</div>
            </div>
        </div>

        <!-- Report Tabs -->
        <div class="report-tabs">
            <button class="tab-btn @(ActiveTab == "revenue" ? "active" : "")" @onclick='() => ChangeTab("revenue")'>
                Revenue Summary
            </button>
            <button class="tab-btn @(ActiveTab == "tax" ? "active" : "")" @onclick='() => ChangeTab("tax")'>
                Tax Summary
            </button>
            <button class="tab-btn @(ActiveTab == "payments" ? "active" : "")" @onclick='() => ChangeTab("payments")'>
                Payment History
            </button>
        </div>

        <!-- Revenue Summary Tab -->
        @if (ActiveTab == "revenue")
        {
            <div class="panel-card">
                <div class="panel-header">
                    <span>Revenue Summary</span>
                    <span class="header-sub">Period: @StartDate.ToString("MMM dd") - @EndDate.ToString("MMM dd, yyyy")</span>
                </div>
                <div class="panel-body" style="overflow-y: visible;">
                    @if (BillSummary.Any())
                    {
                        <div class="chart-container">
                            <div class="chart-wrapper">
                                <canvas id="revenueChart"></canvas>
                            </div>
                            <div class="chart-legend">
                                <h3>Payment Status Breakdown</h3>
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #047857;"></span>
                                    <span class="legend-label">Collected</span>
                                    <span class="legend-value">&#8369;@BillSummary.Sum(b => b.AmountPaid ?? 0).ToString("N2")</span>
                                </div>
                                <div class="legend-item">
                                    <span class="legend-dot" style="background: #991b1b;"></span>
                                    <span class="legend-label">Outstanding</span>
                                    <span class="legend-value">&#8369;@TotalOutstanding.ToString("N2")</span>
                                </div>
                                <div class="legend-divider"></div>
                                <div class="legend-item total">
                                    <span class="legend-label">Total Invoices</span>
                                    <span class="legend-value">@BillSummary.Count (@BillSummary.Count(b => b.BillStatus == "Paid") paid, @BillSummary.Count(b => b.BillStatus != "Paid") pending)</span>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="empty-state">No revenue data for the selected period.</div>
                    }
                </div>
            </div>
        }

        <!-- Tax Summary Tab -->
        @if (ActiveTab == "tax")
        {
            <div class="panel-card">
                <div class="panel-header">
                    <span>Tax Collections Summary</span>
                </div>
                <div class="panel-body">
                    <div class="tax-grid">
                        <div class="tax-card">
                            <h3>Guest Taxes Collected (Estimated)</h3>
                            <p style="font-size: 0.85rem; color: #6b7280; margin-bottom: 16px;">Calculated from paid bill subtotals</p>
                            <div class="tax-row">
                                <span>VAT (12% of Subtotal)</span>
                                <span class="tax-amount">&#8369;@VATCollected.ToString("N2")</span>
                            </div>
                            <div class="tax-row">
                                <span>Service Charge (10% of Subtotal)</span>
                                <span class="tax-amount">&#8369;@ServiceChargeCollected.ToString("N2")</span>
                            </div>
                            <div class="tax-row total">
                                <span>Total Tax Collected</span>
                                <span class="tax-amount primary">&#8369;@TotalTaxCollected.ToString("N2")</span>
                            </div>
                        </div>
                        
                        <div class="tax-card">
                            <h3>Employee Withholding Tax</h3>
                            <p style="font-size: 0.85rem; color: #6b7280; margin-bottom: 16px;">From payroll records</p>
                            <div class="tax-row">
                                <span>Total Payroll Tax Withheld</span>
                                <span class="tax-amount">&#8369;@PayrollTaxWithheld.ToString("N2")</span>
                            </div>
                            <div class="tax-row total">
                                <span>Total Withheld</span>
                                <span class="tax-amount danger">&#8369;@PayrollTaxWithheld.ToString("N2")</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Payment History Tab -->
        @if (ActiveTab == "payments")
        {
            <div class="panel-card">
                <div class="panel-header">
                    <span>Payment History</span>
                    <span class="header-sub">@PaymentHistory.Count payments</span>
                </div>
                <div class="panel-body user-list-container">
                    @if (PaymentHistory.Any())
                    {
                        <table class="user-table">
                            <thead>
                                <tr>
                                    <th>Payment Date</th>
                                    <th>Invoice ID</th>
                                    <th style="text-align:right;">Amount</th>
                                    <th>Method</th>
                                    <th>Reference</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var payment in PaginatedPayments)
                                {
                                    <tr>
                                        <td>@payment.PaymentDate?.ToString("MMM dd, yyyy h:mm tt")</td>
                                        <td style="font-weight: 700; color: var(--color-teal);">INV-@payment.BillId?.ToString("D5")</td>
                                        <td style="font-weight: 900; color: var(--color-dark-teal); text-align:right;">&#8369;@(payment.Amount?.ToString("N2") ?? "0.00")</td>
                                        <td>@payment.PaymentMethod</td>
                                        <td style="font-family: monospace; font-size: 0.85rem;">@payment.ReferenceNumber</td>
                                        <td><span class="status-badge status-paid">@payment.PaymentStatus</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        
                        <!-- Pagination -->
                        <Pagination CurrentPage="@CurrentPaymentPage" 
                                    TotalItems="@PaymentHistory.Count" 
                                    ItemsPerPage="@PaymentsPerPage"
                                    OnPageChanged="@OnPaymentPageChanged"
                                    OnItemsPerPageChangedCallback="@OnPaymentsPerPageChanged" />
                    }
                    else
                    {
                        <div class="empty-state">No payments for the selected period.</div>
                    }
                </div>
            </div>
        }


    </section>
</div>

<style>
