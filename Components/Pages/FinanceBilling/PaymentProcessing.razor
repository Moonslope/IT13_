@page "/finance/payment-processing"
@layout MainLayout
@using HestiaLink.Data
@using HestiaLink.Models
@using Microsoft.EntityFrameworkCore
@inject HestiaLinkContext _context
@inject NavigationManager NavigationManager

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Payment Processing</h1>
            <span class="page-topbar-subtitle">Guest Payment Management</span>
        </div>
        <UserDropdown />
    </header>

    <section class="page-content">
        <!-- Summary Cards - Dashboard Style -->
        <div class="dashboard-hero" style="margin-bottom:32px;">
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M19.14 12.94c.04-.31.06-.63.06-.94 0-.31-.02-.63-.06-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.04.31-.06.63-.06.94s.02.63.06.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/></svg>
                </div>
                <div class="hero-stat-value">&#8369;@TodayPayments.ToString("N2")</div>
                <div class="hero-stat-label">Today's Payments</div>
                <div class="hero-stat-change">Received today</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
                </div>
                <div class="hero-stat-value">@PendingCount</div>
                <div class="hero-stat-label">Pending Payments</div>
                <div class="hero-stat-change">Awaiting completion</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                </div>
                <div class="hero-stat-value">&#8369;@TotalCollected.ToString("N2")</div>
                <div class="hero-stat-label">Total Collected</div>
                <div class="hero-stat-change">All payments received</div>
            </div>
            <div class="hero-stat">
                <div class="hero-stat-icon">
                    <svg viewBox="0 0 24 24"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg>
                </div>
                <div class="hero-stat-value" style="color: rgba(255,255,255,0.95);">&#8369;@OutstandingBalance.ToString("N2")</div>
                <div class="hero-stat-label">Outstanding</div>
                <div class="hero-stat-change">Pending balance</div>
            </div>
        </div>

        <!-- Toolbar -->
        <div class="user-toolbar">
            <div class="toolbar-left">
                <div class="toolbar-search">
                    <input type="text" placeholder="Search by guest or invoice..." @bind="SearchText" @bind:event="oninput" />
                </div>
                <select class="filter-select" @bind="PaymentStatusFilter">
                    <option value="">All Status</option>
                    <option value="Paid">Paid</option>
                    <option value="Partial">Partial</option>
                    <option value="Pending">Pending</option>
                    <option value="Refunded">Refunded</option>
                </select>
                <select class="filter-select" @bind="PaymentMethodFilter">
                    <option value="">All Methods</option>
                    <option value="Cash">Cash</option>
                    <option value="Credit Card">Credit Card</option>
                    <option value="Debit Card">Debit Card</option>
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="GCash">GCash</option>
                    <option value="Maya">Maya</option>
                </select>
            </div>
            <button class="btn-create" @onclick="OpenProcessPaymentModal">Process Payment</button>
        </div>

        <!-- Payments Table -->
        <div class="panel-card">
            <div class="panel-body user-list-container">
                <table class="user-table">
                    <thead>
                        <tr>
                            <th>Invoice ID</th>
                            <th>Guest Name</th>
                            <th>Room</th>
                            <th style="text-align:right;">Total Bill</th>
                            <th style="text-align:right;">Amount Paid</th>
                            <th style="text-align:right;">Balance</th>
                            <th>Payment Method</th>
                            <th>Reference No.</th>
                            <th>Payment Date</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in PaginatedPayments)
                        {
                            <tr>
                                <td style="font-weight: 700; color: var(--color-teal);">INV-@payment.InvoiceId.ToString("D5")</td>
                                <td style="font-weight: 700;">@payment.GuestName</td>
                                <td>@payment.RoomNumber</td>

                                <td style="text-align:right;">&#8369;@payment.TotalBill.ToString("N2")</td>
                                <td style="font-weight: 900; color: var(--color-dark-teal); text-align:right;">&#8369;@payment.AmountPaid.ToString("N2")</td>
                                <td style="font-weight: 700; color: @(payment.Balance > 0 ? "#991b1b" : "#065f46"); text-align:right;">&#8369;@payment.Balance.ToString("N2")</td>
                                <td>
                                    <span class="status-badge" style="color: var(--color-dark-teal);">
                                        @payment.PaymentMethod
                                    </span>
                                </td>
                                <td style="font-family: monospace; font-size: 0.85rem;">@payment.ReferenceNumber</td>
                                <td>@payment.PaymentDate.ToString("MMM dd, yyyy h:mm tt")</td>
                                <td>
                                    <span class="status-badge status-@payment.Status.ToLower()">@payment.Status</span>
                                </td>
                                <td>
                                    <div style="display: flex; gap: 8px; justify-content: center;">
                                        <button class="btn-icon-action edit" title="View Receipt" @onclick="() => ViewReceipt(payment)">
                                            <svg viewBox="0 0 24 24"><path d="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/></svg>
                                        </button>
                                        <button class="btn-icon-action edit" title="Print" @onclick="() => PrintReceipt(payment)">
                                            <svg viewBox="0 0 24 24"><path d="M19 8h-1V3H6v5H5c-1.66 0-3 1.34-3 3v6h4v4h12v-4h4v-6c0-1.66-1.34-3-3-3zM8 5h8v3H8V5zm8 12v5H8v-5h8zm2-2v-2H6v2H4v-4c0-.55.45-1 1-1h14c.55 0 1 .45 1 1v4h-2z"/><circle cx="18" cy="11.5" r="1"/></svg>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <Pagination CurrentPage="@CurrentPage" 
                        TotalItems="@TotalFilteredCount" 
                        ItemsPerPage="@PageSize"
                        OnPageChanged="@OnPageChanged"
                        OnItemsPerPageChangedCallback="@OnItemsPerPageChanged" />
        </div>
    </section>
</div>

<!-- Process Payment Modal -->
@if (ShowProcessModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" style="max-width: 600px;" @onclick:stopPropagation="true">
            <div class="modal-header-teal">
                <h2 style="margin:0; font-size:1.4rem;">Process Payment</h2>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                <label class="form-label">Invoice ID</label>
                <select class="form-select" @bind="NewPayment.InvoiceId" @bind:after="OnInvoiceSelected">
                    <option value="0">-- Select an incomplete invoice --</option>
                    @foreach (var bill in IncompleteBills)
                    {
                        <option value="@bill.BillId">INV-@bill.BillId.ToString("D5") - @bill.GuestName (@bill.RoomNumber) - Balance: ₱@bill.Balance.ToString("N2")</option>
                    }
                </select>
            </div>

            <div class="form-group" style="margin-bottom: 12px;">
                 <label class="form-label">Guest Name</label>
                 <input type="text" class="form-input" @bind="NewPayment.GuestName" readonly style="background-color: #f3f4f6;" />
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div class="form-group">
                    <label class="form-label">Room Number</label>
                    <input type="text" class="form-input" @bind="NewPayment.RoomNumber" readonly style="background-color: #f3f4f6;" />
                </div>
                <div class="form-group">
                    <label class="form-label">Current Balance</label>
                     <!-- Display ONLY the unpaid balance, not full bill, to avoid confusion -->
                    <input type="text" class="form-input" value="₱@(CurrentBillBalance.ToString("N2"))" readonly style="background-color: #f3f4f6; font-weight: bold; color: #991b1b;" />
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 12px;">
                <div class="form-group">
                    <label class="form-label">Amount Paying</label>
                    <input type="number" class="form-input" @bind="NewPayment.AmountPaid" placeholder="0.00" />
                </div>
                <div class="form-group">
                    <label class="form-label">Payment Method</label>
                    <select class="form-select" @bind="NewPayment.PaymentMethod">
                        <option value="Cash">Cash</option>
                        <option value="Credit Card">Credit Card</option>
                        <option value="Debit Card">Debit Card</option>
                        <option value="Bank Transfer">Bank Transfer</option>
                        <option value="GCash">GCash</option>
                        <option value="Maya">Maya</option>
                    </select>
                </div>
            </div>

            <div style="background: var(--color-cream); padding: 12px; border-radius: 8px; margin-bottom: 16px;">
                <div style="display: flex; justify-content: space-between;">
                    <span style="font-weight: 600;">Balance After Payment:</span>
                    <span style="font-weight: 900; color: var(--color-dark-teal); font-size: 1.1rem;">&#8369;@((CurrentBillBalance - NewPayment.AmountPaid).ToString("N2"))</span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(PaymentErrorMessage))
            {
                <div style="background: #fee2e2; color: #991b1b; padding: 10px; border-radius: 8px; margin-bottom: 12px; font-weight: 600;">
                    @PaymentErrorMessage
                </div>
            }
            @if (!string.IsNullOrEmpty(PaymentSuccessMessage))
            {
                <div style="background: #d1fae5; color: #065f46; padding: 10px; border-radius: 8px; margin-bottom: 12px; font-weight: 600;">
                    @PaymentSuccessMessage
                </div>
            }

            <div style="display: flex; gap: 12px;">
                <button class="btn-primary" style="flex: 1;" @onclick="ProcessPayment">Process Payment</button>
                <button class="btn-secondary" style="flex: 1;" @onclick="CloseModals">Cancel</button>
            </div>
        </div>
    </div>
}

<!-- Receipt Modal -->
@if (ShowReceiptModal && SelectedPayment != null)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" style="max-width: 450px; padding: 0;" @onclick:stopPropagation="true">
            <div style="background: var(--color-teal); color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
                <h2 style="margin: 0; font-size: 1.5rem;">OFFICIAL RECEIPT</h2>
                <div style="font-size: 0.9rem; opacity: 0.9; margin-top: 4px;">Hestia Link Hotel Management</div>
            </div>
            
            <div style="padding: 24px;">
                <div style="text-align: center; margin-bottom: 24px; border-bottom: 2px dashed #d1d5db; padding-bottom: 20px;">
                    <div style="font-size: 0.85rem; color: #6b7280; font-weight: 600;">AMOUNT PAID</div>
                    <div style="font-size: 2.5rem; font-weight: 900; color: var(--color-dark-teal);">&#8369;@SelectedPayment.AmountPaid.ToString("N2")</div>

                </div>

                <div style="display: grid; gap: 12px; font-size: 0.95rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Reference No.</span>
                        <span style="font-weight: 700; font-family: monospace;">@SelectedPayment.ReferenceNumber</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Payment Date</span>
                        <span style="font-weight: 600;">@SelectedPayment.PaymentDate.ToString("MMM dd, yyyy h:mm tt")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Payment Method</span>
                        <span style="font-weight: 600;">@SelectedPayment.PaymentMethod</span>
                    </div>
                    <div style="border-top: 1px solid #f3f4f6; margin: 8px 0;"></div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Invoice ID</span>
                        <span style="font-weight: 600;">INV-@SelectedPayment.InvoiceId.ToString("D5")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Guest Name</span>
                        <span style="font-weight: 600;">@SelectedPayment.GuestName</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Room</span>
                        <span style="font-weight: 600;">@SelectedPayment.RoomNumber</span>
                    </div>
                     <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Balance Due</span>
                        <span style="font-weight: 700; color: @(SelectedPayment.Balance > 0 ? "#991b1b" : "#065f46");">&#8369;@SelectedPayment.Balance.ToString("N2")</span>
                    </div>
                </div>

                <div style="margin-top: 24px;">
                    <button class="btn-primary" style="width: 100%;" @onclick="CloseModals">Close Receipt</button>
                    <button class="btn-secondary" style="width: 100%; margin-top: 8px;" @onclick="() => PrintReceipt(SelectedPayment)">Print Receipt</button>
                </div>
            </div>
        </div>
    </div>
}

<!-- Payment Success Modal -->
@if (ShowPaymentSuccessModal)
{
    <div class="modal-overlay" style="z-index: 9999;">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header" style="background: #0f766e; display: flex; justify-content: space-between; align-items: center;">
                <h2 style="margin: 0; color: white;">✓ Payment Successful</h2>
                <button @onclick="ClosePaymentSuccessModal" style="background: none; border: none; color: white; font-size: 1.5rem; cursor: pointer; padding: 0; line-height: 1;">&times;</button>
            </div>
            
            <div style="padding: 24px; text-align: center;">
                <div style="color: #065f46; background: #d1fae5; padding: 15px; border-radius: 8px; margin-bottom: 16px; font-weight: 600;">
                    Payment has been successfully processed!
                </div>
                
                <div style="background: #f8fafc; padding: 16px; border-radius: 8px; margin-bottom: 16px;">
                    <div style="font-size: 0.85rem; color: #64748b; margin-bottom: 8px;">Amount Paid</div>
                    <div style="font-size: 1.8rem; font-weight: 900; color: #0f766e;">₱@PaymentSuccessAmount.ToString("N2")</div>
                </div>
                
                <div style="display: grid; gap: 8px; text-align: left; font-size: 0.95rem;">
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Invoice:</span>
                        <span style="font-weight: 600;">INV-@PaymentSuccessInvoiceId.ToString("D5")</span>
                    </div>
                    <div style="display: flex; justify-content: space-between;">
                        <span style="color: #6b7280;">Reference:</span>
                        <span style="font-weight: 600; font-family: monospace;">@PaymentSuccessReference</span>
                    </div>
                </div>
            </div>
            
            <div style="padding: 16px; border-top: 1px solid #e5e7eb; text-align: center;">
                <button class="btn-primary" style="width: 100%; max-width: 200px;" @onclick="ClosePaymentSuccessModal">OK</button>
            </div>
        </div>
    </div>
}

<style>
    .status-paid { color: #065f46; }
    .status-partial { color: #92400e; }
    .status-pending { color: #991b1b; }
    .status-refunded { color: var(--color-dark-teal); }
    
    /* Pagination Styles */
    .pagination-container {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 0;
        margin-top: 16px;
        border-top: 1px solid #e5e7eb;
    }
    .pagination-info {
        color: var(--color-teal);
        font-size: 0.9rem;
    }
    .pagination-controls {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .btn-page {
        background: none;
        border: 1px solid #d1d5db;
        padding: 6px 12px;
        border-radius: 6px;
        cursor: pointer;
        color: var(--color-dark-teal);
        font-weight: 600;
        min-width: 36px;
    }
    .btn-page:hover:not(:disabled) {
        background: var(--color-light-gray);
    }
    .btn-page:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }
    .page-indicator {
        color: var(--color-dark-teal);
        font-weight: 600;
        padding: 0 12px;
    }
</style>

@code {
    public class PaymentViewModel
    {
        public int PaymentId { get; set; } // DB ID
        public DateTime PaymentDate { get; set; }
        public int InvoiceId { get; set; }
        public string GuestName { get; set; } = "";
        public string RoomNumber { get; set; } = "";
        public decimal TotalBill { get; set; }
        public decimal AmountPaid { get; set; }
        public decimal Balance { get; set; } // Bill Balance, not just payment balance
        public string PaymentMethod { get; set; } = "Cash";
        public string ReferenceNumber { get; set; } = "";
        public string Status { get; set; } = "Pending";
    }

    public class IncompleteBillViewModel
    {
        public int BillId { get; set; }
        public string GuestName { get; set; } = "";
        public string RoomNumber { get; set; } = "";
        public decimal Balance { get; set; }
    }

    private List<PaymentViewModel> Payments = new List<PaymentViewModel>();
    private List<IncompleteBillViewModel> IncompleteBills = new List<IncompleteBillViewModel>();
    private PaymentViewModel NewPayment = new PaymentViewModel();
    private string SearchText = "";
    private string PaymentStatusFilter = "";
    private string PaymentMethodFilter = "";
    private bool ShowProcessModal = false;
    private decimal CurrentBillBalance = 0; // Helper for modal
    private string PaymentErrorMessage = ""; // For validation errors
    private string PaymentSuccessMessage = ""; // For success messages
    private bool ShowReceiptModal = false;
    private bool ShowPaymentSuccessModal = false;
    private PaymentViewModel? SelectedPayment = null;
    
    // Success modal data
    private decimal PaymentSuccessAmount = 0;
    private int PaymentSuccessInvoiceId = 0;
    private string PaymentSuccessReference = "";

    private decimal TodayPayments => Payments.Where(p => p.PaymentDate.Date == DateTime.Now.Date).Sum(p => p.AmountPaid);
    private int PendingCount => Payments.Count(p => p.Status == "Pending" || p.Status == "Partial"); // Logic adjustment
    private decimal TotalCollected => Payments.Sum(p => p.AmountPaid);
    
    // Outstanding is tricky, it's really the sum of Balances of UNIQUE bills, not payments. 
    // But for simple view, let's sum remaining balances of latest payments? 
    // Better: We should probably fetch Bills separately for the "Outstanding" card. 
    // For now, I'll stick to a simple sum but aware it might double count if multiple payments exist for same bill.
    // Fixed: OutstandingBalance should query Bills directly ideally. 
    // Let's approximate: Distinct Invoices sum of balances.
    private decimal OutstandingBalance => Payments.Select(p => new { p.InvoiceId, p.Balance }).Distinct().Sum(x => x.Balance);

    // Breakdowns
    private decimal CashPayments => Payments.Where(p => p.PaymentMethod == "Cash").Sum(p => p.AmountPaid);
    private int CashPaymentCount => Payments.Count(p => p.PaymentMethod == "Cash");
    
    private decimal CardPayments => Payments.Where(p => p.PaymentMethod == "Credit Card" || p.PaymentMethod == "Debit Card").Sum(p => p.AmountPaid);
    private int CardPaymentCount => Payments.Count(p => p.PaymentMethod == "Credit Card" || p.PaymentMethod == "Debit Card");
    
    private decimal DigitalPayments => Payments.Where(p => p.PaymentMethod == "GCash" || p.PaymentMethod == "Maya").Sum(p => p.AmountPaid);
    private int DigitalPaymentCount => Payments.Count(p => p.PaymentMethod == "GCash" || p.PaymentMethod == "Maya");

    private List<PaymentViewModel> FilteredPayments => Payments
        .Where(p => (string.IsNullOrEmpty(SearchText) || 
                    p.GuestName.Contains(SearchText, StringComparison.OrdinalIgnoreCase) ||
                    p.InvoiceId.ToString().Contains(SearchText)) &&
                    (string.IsNullOrEmpty(PaymentStatusFilter) || p.Status == PaymentStatusFilter) &&
                    (string.IsNullOrEmpty(PaymentMethodFilter) || p.PaymentMethod == PaymentMethodFilter))
        .OrderByDescending(p => p.PaymentDate)
        .ToList();

    // Pagination
    private int CurrentPage = 1;
    private int PageSize = 10;
    private int TotalFilteredCount => FilteredPayments.Count;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)TotalFilteredCount / PageSize));
    
    private List<PaymentViewModel> PaginatedPayments => FilteredPayments
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();

    private void OnPageChanged(int page)
    {
        if (page >= 1 && page <= TotalPages)
        {
            CurrentPage = page;
        }
    }

    private void OnItemsPerPageChanged(int itemsPerPage)
    {
        PageSize = itemsPerPage;
        CurrentPage = 1;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
        await LoadIncompleteBills();
    }

    private async Task LoadPayments()
    {
        try 
        {
            var payments = await _context.Payments
                .Include(p => p.Bill!)
                .ThenInclude(b => b!.Reservation!)
                .ThenInclude(r => r!.Guest)
                .Include(p => p.Bill!)
                .ThenInclude(b => b!.Reservation!)
                .ThenInclude(r => r!.ReservedRooms)
                .ThenInclude(rr => rr.Room)
                .ToListAsync();

            Payments = payments.Where(p => p.Bill != null).Select(p => new PaymentViewModel
            {
                PaymentId = p.PaymentId,
                PaymentDate = p.PaymentDate ?? DateTime.Now,
                InvoiceId = p.BillId ?? 0,
                GuestName = p.Bill?.Reservation?.Guest != null ? $"{p.Bill.Reservation.Guest.FirstName} {p.Bill.Reservation.Guest.LastName}" : "Unknown",
                RoomNumber = p.Bill?.Reservation?.ReservedRooms.FirstOrDefault()?.Room?.RoomNumber ?? "N/A",
                TotalBill = p.Bill?.GrandTotal ?? 0,
                AmountPaid = p.Amount ?? 0,
                Balance = (p.Bill?.GrandTotal ?? 0) - (p.Bill?.AmountPaid ?? 0), // Calc real balance from Bill
                PaymentMethod = p.PaymentMethod ?? "Cash",
                ReferenceNumber = p.ReferenceNumber ?? "",
                Status = p.Bill?.BillStatus ?? "Pending"
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payments: {ex.Message}");
        }
    }

    private async Task LoadIncompleteBills()
    {
        try
        {
            var incompleteBills = await _context.Bills
                .Include(b => b.Reservation!)
                .ThenInclude(r => r!.Guest)
                .Include(b => b.Reservation!)
                .ThenInclude(r => r!.ReservedRooms)
                .ThenInclude(rr => rr.Room)
                .Where(b => b.BillStatus == "Pending" || b.BillStatus == "Partial")
                .ToListAsync();

            IncompleteBills = incompleteBills.Select(b => new IncompleteBillViewModel
            {
                BillId = b.BillId,
                GuestName = b.Reservation?.Guest != null ? $"{b.Reservation.Guest.FirstName} {b.Reservation.Guest.LastName}" : "Unknown",
                RoomNumber = b.Reservation?.ReservedRooms.FirstOrDefault()?.Room?.RoomNumber ?? "N/A",
                Balance = (b.GrandTotal ?? 0) - (b.AmountPaid ?? 0)
            }).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading incomplete bills: {ex.Message}");
        }
    }

    private async Task OpenProcessPaymentModal()
    {
        // Reload incomplete bills to get latest data
        await LoadIncompleteBills();

        // Generate auto reference number: REF-yyyyMMddHHmmss
        var refNumber = $"REF-{DateTime.Now:yyyyMMddHHmmss}";
        NewPayment = new PaymentViewModel { PaymentDate = DateTime.Now, PaymentMethod = "Cash", ReferenceNumber = refNumber };
        CurrentBillBalance = 0;
        PaymentErrorMessage = "";
        PaymentSuccessMessage = "";
        ShowProcessModal = true;
    }

    private async Task OnInvoiceSelected()
    {
        if (NewPayment.InvoiceId > 0)
        {
            await FetchBillDetails();
        }
    }

    private async Task FetchBillDetails()
    {
        if (NewPayment.InvoiceId == 0) return;

        var bill = await _context.Bills
            .Include(b => b.Reservation!)
            .ThenInclude(r => r!.Guest)
            .Include(b => b.Reservation!)
            .ThenInclude(r => r!.ReservedRooms)
            .ThenInclude(rr => rr.Room)
            .FirstOrDefaultAsync(b => b.BillId == NewPayment.InvoiceId);

        if (bill != null)
        {
            NewPayment.GuestName = bill.Reservation?.Guest != null ? $"{bill.Reservation.Guest.FirstName} {bill.Reservation.Guest.LastName}" : "Unknown";
            NewPayment.RoomNumber = bill.Reservation?.ReservedRooms.FirstOrDefault()?.Room?.RoomNumber ?? "N/A";
            NewPayment.TotalBill = bill.GrandTotal ?? 0;
            
            // Calculate what has been paid so far
            decimal alreadyPaid = await _context.Payments.Where(p => p.BillId == bill.BillId).SumAsync(p => p.Amount ?? 0);
            CurrentBillBalance = Math.Max(0, (bill.GrandTotal ?? 0) - alreadyPaid);
            
            // Default amount to pay = balance (if balance > 0)
            NewPayment.AmountPaid = CurrentBillBalance > 0 ? CurrentBillBalance : 0;
        }
    }

    private async Task ProcessPayment()
    {
        PaymentErrorMessage = "";
        PaymentSuccessMessage = "";

        // Validation
        if (NewPayment.InvoiceId == 0)
        {
            PaymentErrorMessage = "Please search for a valid Invoice ID first.";
            return;
        }
        if (NewPayment.AmountPaid <= 0)
        {
            PaymentErrorMessage = "Amount must be greater than 0.";
            return;
        }
        if (string.IsNullOrEmpty(NewPayment.GuestName) || NewPayment.GuestName == "Unknown")
        {
            PaymentErrorMessage = "Please search for a valid Invoice ID first.";
            return;
        }

        try
        {
            // Use execution strategy for SQL Server retry support
            var strategy = _context.Database.CreateExecutionStrategy();
            await strategy.ExecuteAsync(async () =>
            {
                using var transaction = await _context.Database.BeginTransactionAsync();
                try
                {
                    // 1. Record Payment
                    var dbPayment = new HestiaLink.Models.Payment
                    {
                        BillId = NewPayment.InvoiceId,
                        Amount = NewPayment.AmountPaid,
                        PaymentDate = DateTime.Now,
                        PaymentMethod = NewPayment.PaymentMethod,
                        ReferenceNumber = NewPayment.ReferenceNumber,
                        PaymentStatus = "Completed"
                    };
                    _context.Payments.Add(dbPayment);
                    await _context.SaveChangesAsync();

                    // 2. Update Bill Balance/Status
                    var bill = await _context.Bills.FindAsync(NewPayment.InvoiceId);
                    if (bill != null)
                    {
                        var existingPaid = bill.AmountPaid ?? 0;
                        bill.AmountPaid = existingPaid + NewPayment.AmountPaid;

                        if (bill.AmountPaid >= bill.GrandTotal)
                        {
                            bill.BillStatus = "Paid";
                            bill.BalanceDue = 0;
                        }
                        else
                        {
                            bill.BillStatus = "Partial";
                            bill.BalanceDue = bill.GrandTotal - bill.AmountPaid;
                        }
                        _context.Bills.Update(bill);
                        await _context.SaveChangesAsync();
                    }

                    await transaction.CommitAsync();

                    // Store success data for modal
                     PaymentSuccessAmount = NewPayment.AmountPaid;
                    PaymentSuccessInvoiceId = NewPayment.InvoiceId;
                    PaymentSuccessReference = NewPayment.ReferenceNumber;
                }
                catch
                {
                    await transaction.RollbackAsync();
                    throw;
                }
            });

            await LoadPayments();
            CloseModals();
            
            // Show success modal
            ShowPaymentSuccessModal = true;
        }
        catch (Exception ex)
        {
            PaymentErrorMessage = $"Error: {ex.Message}";
        }
    }

