@code {
    private Employee? CurrentEmployee;
    private EmployeeAttendance? TodayAttendance;
    private List<EmployeeAttendance> RecentAttendance = new();
    private bool IsLoaded = false;
    private bool IsProcessing = false;
    private bool ShowCheckInModal = false;
    private bool ShowCheckOutModal = false;

    protected override async Task OnInitializedAsync()
    {
        if (!UserSession.IsAuthenticated)
        {
            Navigation.NavigateTo("/loginpage");
            return;
        }

        await LoadData();
        
        // Update time display every second
        _ = Task.Run(async () =>
        {
            while (true)
            {
                await Task.Delay(1000);
                if (IsLoaded)
                {
                    StateHasChanged();
                }
            }
        });
    }

    private async Task LoadData()
    {
        try
        {
            IsLoaded = false;
            StateHasChanged();

            using var context = ContextFactory.CreateDbContext();

            // Get employee from user's EmployeeID
            if (UserSession.UserID > 0)
            {
                var user = await context.SystemUsers
                    .FirstOrDefaultAsync(u => u.UserID == UserSession.UserID);

                if (user?.EmployeeID != null)
                {
                    CurrentEmployee = await context.Employees
                        .Include(e => e.Position)
                        .FirstOrDefaultAsync(e => e.EmployeeId == user.EmployeeID);
                }
            }

            if (CurrentEmployee == null)
            {
                IsLoaded = true;
                return;
            }

            // Get today's attendance
            var today = DateOnly.FromDateTime(DateTime.Now);
            TodayAttendance = await DTRService.GetTodayAttendanceAsync(CurrentEmployee.EmployeeId);

            // Get recent attendance (last 30 days)
            var startDate = today.AddDays(-30);
            RecentAttendance = await DTRService.GetMonthlyAttendanceAsync(
                CurrentEmployee.EmployeeId, 
                today.Year, 
                today.Month);

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error loading data: {ex.Message}");
            IsLoaded = true;
        }
    }

    private void HandleCheckIn()
    {
        if (CurrentEmployee == null || IsProcessing) return;
        ShowCheckInModal = true;
        StateHasChanged();
    }

    private void HandleCheckOut()
    {
        if (CurrentEmployee == null || IsProcessing) return;
        ShowCheckOutModal = true;
        StateHasChanged();
    }

    private void CloseCheckInModal()
    {
        ShowCheckInModal = false;
    }

    private void CloseCheckOutModal()
    {
        ShowCheckOutModal = false;
    }

    private async Task ConfirmCheckIn()
    {
        if (CurrentEmployee == null || IsProcessing) return;

        try
        {
            IsProcessing = true;
            ShowCheckInModal = false;
            StateHasChanged();

            var result = await DTRService.ClockInAsync(
                CurrentEmployee.EmployeeId, 
                UserSession.UserID);

            if (result.Success)
            {
                await JSRuntime.InvokeVoidAsync("alert", "Check-in successful!");
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private async Task ConfirmCheckOut()
    {
        if (CurrentEmployee == null || IsProcessing) return;

        try
        {
            IsProcessing = true;
            ShowCheckOutModal = false;
            StateHasChanged();

            var result = await DTRService.ClockOutAsync(
                CurrentEmployee.EmployeeId, 
                UserSession.UserID);

            if (result.Success)
            {
                await JSRuntime.InvokeVoidAsync("alert", 
                    $"Check-out successful! Total hours: {result.Attendance?.TotalHours?.ToString("F2") ?? "0.00"}");
                await LoadData();
            }
            else
            {
                await JSRuntime.InvokeVoidAsync("alert", result.Message);
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error: {ex.Message}");
        }
        finally
        {
            IsProcessing = false;
            StateHasChanged();
        }
    }

    private string GetCurrentShiftStatus()
    {
        if (TodayAttendance == null || TodayAttendance.ClockInTime == null)
            return "Not Started";
        
        if (TodayAttendance.ClockOutTime == null)
            return "In Progress";
        
        return "Completed";
    }

    private string GetTodayHours()
    {
        if (TodayAttendance?.TotalHours != null)
            return $"{TodayAttendance.TotalHours:F2} hrs";
        
        if (TodayAttendance?.ClockInTime != null && TodayAttendance.ClockOutTime == null)
        {
            var worked = DateTime.Now - TodayAttendance.ClockInTime.Value;
            return $"{worked.TotalHours:F2} hrs";
        }
        
        return "0.00 hrs";
    }

    private string GetMonthlyHours()
    {
        var total = RecentAttendance.Sum(a => a.TotalHours ?? 0);
        return $"{total:F2} hrs";
    }

    private string GetAttendanceStatus()
    {
        if (TodayAttendance == null)
            return "Not Checked In";
        
        if (TodayAttendance.ClockOutTime == null)
            return "Checked In";
        
        return "Checked Out";
    }

    private string GetWorkedHours()
    {
        if (TodayAttendance?.ClockInTime == null)
            return "0.00 hrs";
        
        if (TodayAttendance.ClockOutTime != null)
            return $"{TodayAttendance.TotalHours?.ToString("F2") ?? "0.00"} hrs";
        
        var worked = DateTime.Now - TodayAttendance.ClockInTime.Value;
        return $"{worked.TotalHours:F2} hrs";
    }

    private string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "present" => "status-present",
            "absent" => "status-absent",
            "late" => "status-late",
            _ => "status-present"
        };
    }

    [Inject] private NavigationManager Navigation { get; set; } = null!;
}

