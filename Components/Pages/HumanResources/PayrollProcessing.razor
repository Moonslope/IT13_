@code {
    // State
    private List<Tax> TaxRates = new();
    private List<VwEmployeePayrollSummary> EmployeePayrollSummary = new();
    private List<Department> Departments = new();
    private Tax NewTax = new();
    private VwEmployeePayrollSummary? SelectedEmployee;
    private string SelectedPaymentStatus = "Pending";
    private string SelectedPeriod = "2025-01-01";
    private int DepartmentFilter = 0;
    private int CurrentPage = 1;
    private int ItemsPerPage = 10;
    private bool ShowTaxModal = false;
    private bool ShowEmployeePaymentModal = false;
    private bool IsLoaded = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;

    // Summary Calculations
    private decimal TotalIncome = 0m;
    private int TotalEmployees = 0;
    private decimal TotalEmployeePayments = 0m;
    private decimal TotalTaxesDeducted = 0m;

    private List<VwEmployeePayrollSummary> FilteredPayrollSummary =>
        DepartmentFilter == 0
            ? EmployeePayrollSummary
            : EmployeePayrollSummary.Where(e => e.DepartmentId == DepartmentFilter).ToList();

    private IEnumerable<VwEmployeePayrollSummary> PagedPayrollSummary => FilteredPayrollSummary
        .Skip((CurrentPage - 1) * ItemsPerPage)
        .Take(ItemsPerPage);

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        try
        {
            HasError = false;
            ErrorMessage = string.Empty;

            // Load departments for filter
            Departments = await Context.Departments
                .Where(d => d.Status == "Active")
                .AsNoTracking()
                .OrderBy(d => d.DepartmentName)
                .ToListAsync();

            // Load tax rates
            TaxRates = await Context.Taxes
                .Select(t => new Tax
                {
                    TaxId = t.TaxId,
                    TaxName = t.TaxName,
                    TaxPercentage = Convert.ToInt32(t.TaxPercentage),
                    TaxDescription = t.TaxDescription,
                    Status = t.Status
                })
                .AsNoTracking()
                .OrderBy(t => t.TaxName)
                .ToListAsync();

            // CRITICAL FIX: Force refresh of the view with explicit query
            await RefreshPayrollViewData();

            // Calculate summary totals
            await CalculateSummaryTotals();

            CurrentPage = 1; // reset pagination after data refresh

            IsLoaded = true;
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            IsLoaded = true;
        }
    }

    private async Task CalculateSummaryTotals()
    {
        try
        {
            // Get current month's start and end dates
            var now = DateTime.Now;
            var monthStart = new DateTime(now.Year, now.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            // TOTAL INCOME: Get all income for current month
            TotalIncome = await Context.Incomes
                .Where(i => i.IncomeDate >= DateOnly.FromDateTime(monthStart) && i.IncomeDate <= DateOnly.FromDateTime(monthEnd))
                .SumAsync(i => i.Amount ?? 0);

            // Total Active Employees
            TotalEmployees = await Context.Employees
                .CountAsync(e => e.Status == "Active");

            // Total Employee Payments for current month
            TotalEmployeePayments = await Context.Payrolls
                .Where(p => p.PeriodStart >= DateOnly.FromDateTime(monthStart) && p.PeriodEnd <= DateOnly.FromDateTime(monthEnd))
                .SumAsync(p => p.GrossPay ?? 0);

            // Total Taxes Deducted for current month
            TotalTaxesDeducted = await Context.Payrolls
                .Where(p => p.PeriodStart >= DateOnly.FromDateTime(monthStart) && p.PeriodEnd <= DateOnly.FromDateTime(monthEnd))
                .SumAsync(p => p.TaxAmount ?? 0);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in CalculateSummaryTotals: {ex.Message}");
            TotalIncome = 0m;
            TotalEmployees = EmployeePayrollSummary.Count;
            TotalEmployeePayments = EmployeePayrollSummary.Sum(e => e.TotalSalary ?? 0);
            TotalTaxesDeducted = 0m;
        }
    }

    private async Task LoadPayrollData()
    {
        IsLoaded = false;
        StateHasChanged();
        await Task.Delay(300);
        await LoadData();
    }

    private Task HandlePageChanged(int page)
    {
        CurrentPage = page;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleItemsPerPageChanged(int newSize)
    {
        ItemsPerPage = newSize;
        CurrentPage = 1;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task RetryLoad()
    {
        IsLoaded = false;
        StateHasChanged();
        await Task.Delay(500);
        await LoadData();
    }

    private void OpenTaxModal()
    {
        NewTax = new Tax();
        ShowTaxModal = true;
    }

    private async Task AddNewTax()
    {
        if (string.IsNullOrWhiteSpace(NewTax.TaxName) || NewTax.TaxPercentage <= 0m)
        {
            await JSRuntime.InvokeVoidAsync("alert", "Please enter a valid tax name and percentage.");
            return;
        }

        try
        {
            var tax = new Tax
            {
                TaxName = NewTax.TaxName.Trim(),
                TaxPercentage = NewTax.TaxPercentage,
                TaxDescription = NewTax.TaxDescription?.Trim(),
                Status = "Active"
            };

            Context.Taxes.Add(tax);
            await Context.SaveChangesAsync();

            TaxRates = await Context.Taxes
                .Select(t => new Tax
                {
                    TaxId = t.TaxId,
                    TaxName = t.TaxName,
                    TaxPercentage = Convert.ToInt32(t.TaxPercentage),
                    TaxDescription = t.TaxDescription,
                    Status = t.Status
                })
                .AsNoTracking()
                .OrderBy(t => t.TaxName)
                .ToListAsync();

            NewTax = new Tax();
            await CalculateSummaryTotals();
            await JSRuntime.InvokeVoidAsync("alert", "Tax added successfully!");
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error adding tax: {ex.Message}");
        }
    }

    private async Task ToggleTaxStatus(Tax tax)
    {
        try
        {
            var existingTax = await Context.Taxes.FindAsync(tax.TaxId);
            if (existingTax != null)
            {
                existingTax.Status = existingTax.Status == "Active" ? "Archived" : "Active";
                await Context.SaveChangesAsync();

                TaxRates = await Context.Taxes
                    .Select(t => new Tax
                    {
                        TaxId = t.TaxId,
                        TaxName = t.TaxName,
                        TaxPercentage = Convert.ToInt32(t.TaxPercentage),
                        TaxDescription = t.TaxDescription,
                        Status = t.Status
                    })
                    .AsNoTracking()
                    .OrderBy(t => t.TaxName)
                    .ToListAsync();

                await CalculateSummaryTotals();
                await JSRuntime.InvokeVoidAsync("alert", $"Tax status updated to {existingTax.Status}");
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error updating tax: {ex.Message}");
        }
    }

    private void OpenEmployeePaymentModal(VwEmployeePayrollSummary employee)
    {
        SelectedEmployee = employee;
        SelectedPaymentStatus = employee.PaymentStatus;
        ShowEmployeePaymentModal = true;
    }

    private async Task UpdateEmployeePayment()
    {
        if (SelectedEmployee == null) return;

        try
        {
            var periodStart = DateTime.Parse(SelectedPeriod);
            var periodEnd = periodStart.AddDays(14);

            // Get first active tax ID if available
            int? taxId = TaxRates.FirstOrDefault(t => t.Status == "Active")?.TaxId;

            // Calculate total hours from attendance records for this period
            var periodStartDate = DateOnly.FromDateTime(periodStart);
            var periodEndDate = DateOnly.FromDateTime(periodEnd);
            
            // Get all attendance records for this employee within the period
            var attendanceRecords = await Context.Attendances
                .Include(a => a.Schedule)
                .Where(a => a.Schedule != null && 
                           a.Schedule.EmployeeId == SelectedEmployee.EmployeeId &&
                           a.AttendanceDate >= periodStartDate &&
                           a.AttendanceDate <= periodEndDate)
                .ToListAsync();

            // Calculate total hours from attendance records
            decimal calculatedTotalHours = attendanceRecords
                .Sum(a => (a.RegularHours ?? 0) + (a.OvertimeHours ?? 0));
            
            decimal calculatedRegularHours = attendanceRecords
                .Sum(a => a.RegularHours ?? 0);
            
            decimal calculatedOvertimeHours = attendanceRecords
                .Sum(a => a.OvertimeHours ?? 0);

            // Get first attendance ID for reference (or use the first one found)
            int? attendanceId = attendanceRecords.FirstOrDefault()?.AttendanceId;

            // If no attendance records found for the period, find any attendance for this employee
            if (!attendanceId.HasValue)
            {
                var anyAttendance = await Context.Attendances
                    .Include(a => a.Schedule)
                    .Where(a => a.Schedule != null && a.Schedule.EmployeeId == SelectedEmployee.EmployeeId)
                    .OrderByDescending(a => a.AttendanceDate)
                    .FirstOrDefaultAsync();
                
                attendanceId = anyAttendance?.AttendanceId;
            }

            // If still no attendance exists, create a placeholder attendance record
            if (!attendanceId.HasValue)
            {
                // Find or create a schedule for the employee
                var schedule = await Context.Schedules
                    .Where(s => s.EmployeeId == SelectedEmployee.EmployeeId && s.IsActive == true)
                    .OrderByDescending(s => s.ScheduleDate)
                    .FirstOrDefaultAsync();

                if (schedule == null)
                {
                    // Create a default schedule for the period start date
                    schedule = new HestiaLink.Models.Schedule
                    {
                        EmployeeId = SelectedEmployee.EmployeeId,
                        ScheduleDate = periodStartDate,
                        ScheduledStart = TimeOnly.FromTimeSpan(new TimeSpan(9, 0, 0)), // 9 AM default
                        ScheduledEnd = TimeOnly.FromTimeSpan(new TimeSpan(17, 0, 0)), // 5 PM default
                        IsActive = true,
                        CreatedAt = DateTime.UtcNow,
                        UpdatedAt = DateTime.UtcNow
                    };
                    Context.Schedules.Add(schedule);
                    await Context.SaveChangesAsync();
                }

                // Create a placeholder attendance record
                var placeholderAttendance = new HestiaLink.Models.Attendance
                {
                    ScheduleId = schedule.ScheduleId,
                    AttendanceDate = periodStartDate,
                    AttendanceStatus = "Present",
                    RegularHours = calculatedRegularHours,
                    OvertimeHours = calculatedOvertimeHours,
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                Context.Attendances.Add(placeholderAttendance);
                await Context.SaveChangesAsync();
                attendanceId = placeholderAttendance.AttendanceId;
            }

            // Calculate pay values using calculated hours from attendance
            decimal regularPay = calculatedRegularHours * (SelectedEmployee.HourlyRate ?? 0);
            decimal overtimePay = calculatedOvertimeHours * ((SelectedEmployee.HourlyRate ?? 0) * 1.5m);
            decimal grossPay = regularPay + overtimePay;

            // Calculate tax amount from active taxes
            decimal activeTaxPercentage = TaxRates
                .Where(t => t.Status == "Active")
                .Sum(t => t.TaxPercentage);
            decimal taxAmount = grossPay * (activeTaxPercentage / 100m);
            decimal netPay = grossPay - taxAmount;

            // CRITICAL FIX: Get or create TotalIncomeID for this payroll period
            var periodStartDateOnly = DateOnly.FromDateTime(periodStart);
            var periodEndDateOnly = DateOnly.FromDateTime(periodEnd);

            var totalIncome = await Context.TotalIncomes
                .Where(ti => ti.PeriodStart <= periodStartDateOnly && ti.PeriodEnd >= periodEndDateOnly)
                .OrderByDescending(ti => ti.CreatedDate)
                .FirstOrDefaultAsync();

            int? incomeId = totalIncome?.IncomeId;

            // If no TotalIncome record exists for this period, create one
            if (incomeId == null)
            {
                // Create a default TotalIncome record for the period
                var newTotalIncome = new HestiaLink.Models.TotalIncome
                {
                    PeriodStart = periodStartDateOnly,
                    PeriodEnd = periodEndDateOnly,
                    TotalAmount = 100000m, // Default starting amount
                    Status = "Active",
                    CreatedDate = DateTime.Now
                };
                Context.TotalIncomes.Add(newTotalIncome);
                await Context.SaveChangesAsync();
                incomeId = newTotalIncome.IncomeId;
            }

            // Check if payroll already exists for this period and employee
            // We need to check via the attendance's schedule to find the employee
            var existingPayroll = await Context.Payrolls
                .Include(p => p.Attendance)
                    .ThenInclude(a => a.Schedule)
                .Where(p => p.PeriodStart == DateOnly.FromDateTime(periodStart) && 
                           p.PeriodEnd == DateOnly.FromDateTime(periodEnd) &&
                           p.Attendance.Schedule != null &&
                           p.Attendance.Schedule.EmployeeId == SelectedEmployee.EmployeeId)
                .FirstOrDefaultAsync();

            if (existingPayroll != null)
            {
                // Store old status for comparison
                var oldStatus = existingPayroll.Status;

                // Update existing payroll with calculated hours from attendance
                existingPayroll.Status = SelectedPaymentStatus;
                existingPayroll.TotalHours = calculatedTotalHours;
                existingPayroll.OvertimeHours = calculatedOvertimeHours;
                existingPayroll.HourlyRate = SelectedEmployee.HourlyRate;
                existingPayroll.RegularPay = regularPay;
                existingPayroll.OvertimePay = overtimePay;
                existingPayroll.GrossPay = grossPay;
                existingPayroll.TaxAmount = taxAmount;
                existingPayroll.NetPay = netPay;
                existingPayroll.TaxId = taxId;
                existingPayroll.IncomeId = incomeId; // Always set IncomeID

                // CRITICAL FIX: Handle TotalIncome adjustment properly
                var totalIncomeRecord = await Context.TotalIncomes.FindAsync(incomeId);
                if (totalIncomeRecord != null)
                {
                    // If changing from non-Paid to Paid, subtract
                    if (oldStatus != "Paid" && SelectedPaymentStatus == "Paid")
                    {
                        totalIncomeRecord.TotalAmount = (totalIncomeRecord.TotalAmount ?? 0) - grossPay;
                        if (totalIncomeRecord.TotalAmount < 0) totalIncomeRecord.TotalAmount = 0;
                    }
                    // If changing from Paid to non-Paid, add back
                    else if (oldStatus == "Paid" && SelectedPaymentStatus != "Paid")
                    {
                        totalIncomeRecord.TotalAmount = (totalIncomeRecord.TotalAmount ?? 0) + grossPay;
                    }
                    // If staying as Paid and amount changed, adjust
                    else if (oldStatus == "Paid" && SelectedPaymentStatus == "Paid")
                    {
                        // Calculate the difference
                        decimal difference = grossPay - (existingPayroll.GrossPay ?? 0);
                        totalIncomeRecord.TotalAmount = (totalIncomeRecord.TotalAmount ?? 0) - difference;
                        if (totalIncomeRecord.TotalAmount < 0) totalIncomeRecord.TotalAmount = 0;
                    }
                }

                await Context.SaveChangesAsync();
            }
            else
            {
                // Create new payroll with calculated hours from attendance
                var newPayroll = new Payroll
                {
                    AttendanceId = attendanceId.Value, // Now guaranteed to have a value
                    IncomeId = incomeId, // Always set IncomeID
                    TaxId = taxId,
                    PeriodStart = DateOnly.FromDateTime(periodStart),
                    PeriodEnd = DateOnly.FromDateTime(periodEnd),
                    TotalHours = calculatedTotalHours,
                    OvertimeHours = calculatedOvertimeHours,
                    HourlyRate = SelectedEmployee.HourlyRate,
                    RegularPay = regularPay,
                    OvertimePay = overtimePay,
                    GrossPay = grossPay,
                    TaxAmount = taxAmount,
                    NetPay = netPay,
                    Status = SelectedPaymentStatus,
                    CreatedDate = DateTime.Now
                };

                // CRITICAL FIX: Subtract from TotalIncome only if status is Paid
                if (SelectedPaymentStatus == "Paid" && incomeId.HasValue)
                {
                    var totalIncomeRecord = await Context.TotalIncomes.FindAsync(incomeId.Value);
                    if (totalIncomeRecord != null)
                    {
                        totalIncomeRecord.TotalAmount = (totalIncomeRecord.TotalAmount ?? 0) - grossPay;
                        if (totalIncomeRecord.TotalAmount < 0) totalIncomeRecord.TotalAmount = 0;
                    }
                }

                Context.Payrolls.Add(newPayroll);
                await Context.SaveChangesAsync();
            }

            // CRITICAL FIX: Force refresh the view data
            await RefreshPayrollViewData();

            await JSRuntime.InvokeVoidAsync("alert", $"Payment status updated to {SelectedPaymentStatus}");
            CloseModals();

            // Force UI refresh
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error in UpdateEmployeePayment: {ex.Message}");
            Console.WriteLine($"Inner Exception: {ex.InnerException?.Message}");

            await JSRuntime.InvokeVoidAsync("alert", $"Error updating payment: {ex.Message}\n{ex.InnerException?.Message}");
        }
    }

    private void CloseModals()
    {
        ShowTaxModal = false;
        ShowEmployeePaymentModal = false;
        SelectedEmployee = null;
        NewTax = new Tax();
    }

    private string GetPaymentStatusClass(string status)
    {
        return status switch
        {
            "Paid" => "status-paid",
            "Processing" => "status-processing",
            "On Hold" => "status-onhold",
            _ => "status-pending"
        };
    }

    private async Task RefreshIncomeData()
    {
        try
        {
            var now = DateTime.Now;
            var monthStart = new DateTime(now.Year, now.Month, 1);
            var monthEnd = monthStart.AddMonths(1).AddDays(-1);

            TotalIncome = await Context.Incomes
                .Where(i => i.IncomeDate >= DateOnly.FromDateTime(monthStart) && i.IncomeDate <= DateOnly.FromDateTime(monthEnd))
                .SumAsync(i => i.Amount ?? 0);

            await CalculateSummaryTotals();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing income data: {ex.Message}");
        }
    }

    // CRITICAL FIX: New method to properly refresh the view data with actual Payroll status
    private async Task RefreshPayrollViewData()
    {
        try
        {
            // Clear the current list
            EmployeePayrollSummary.Clear();

            // Force a fresh query from the database view
            var freshData = await Context.VwEmployeePayrollSummaries
                .AsNoTracking()
                .OrderBy(e => e.EmployeeName)
                .ToListAsync();

            // Get the current period dates
            var periodStart = DateTime.Parse(SelectedPeriod);
            var periodEnd = periodStart.AddDays(14);
            var periodStartDate = DateOnly.FromDateTime(periodStart);
            var periodEndDate = DateOnly.FromDateTime(periodEnd);

            // Get actual Payroll records for this period to update PaymentStatus
            var payrollRecords = await Context.Payrolls
                .Include(p => p.Attendance)
                    .ThenInclude(a => a.Schedule)
                .Where(p => p.PeriodStart == periodStartDate && 
                           p.PeriodEnd == periodEndDate &&
                           p.Attendance.Schedule != null)
                .AsNoTracking()
                .ToListAsync();

            // Create a dictionary to map EmployeeId to Payroll Status
            var payrollStatusMap = payrollRecords
                .Where(p => p.Attendance?.Schedule != null)
                .GroupBy(p => p.Attendance.Schedule.EmployeeId)
                .ToDictionary(g => g.Key, g => g.OrderByDescending(p => p.CreatedDate).First().Status ?? "Pending");

            // Update PaymentStatus in the view data based on actual Payroll records
            foreach (var employee in freshData)
            {
                if (payrollStatusMap.ContainsKey(employee.EmployeeId))
                {
                    employee.PaymentStatus = payrollStatusMap[employee.EmployeeId];
                }
            }

            // Update the list
            EmployeePayrollSummary = freshData;

            // Force UI update
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error refreshing payroll view: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
        }
    }
}