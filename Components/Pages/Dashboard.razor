@page "/dashboard"
@using HestiaLink.Data
@using HestiaLink.Models
@using HestiaLink.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<HestiaLinkContext> DbFactory
@inject NavigationManager Navigation
@inject UserSession UserSession
@inject IJSRuntime JSRuntime
@inject HousekeepingService HousekeepingService

<div class="page-wrapper">
    <header class="page-topbar">
        <div>
            <h1>Dashboard</h1>
        </div>
        <UserDropdown />
    </header>

    <section class="page-content">
        @if (!IsLoaded)
        {
            <div class="skeleton-wrapper">
                <div class="skeleton-grid">
                    @for (int i = 0; i < 9; i++)
                    {
                        <div class="skeleton-card"></div>
                    }
                </div>
                <div class="skeleton-charts">
                    <div class="skeleton-chart"></div>
                    <div class="skeleton-chart"></div>
                    <div class="skeleton-chart"></div>
                </div>
            </div>
        }
        else if (HasError)
        {
            <div style="padding:12px; border-radius:8px; background:#fff4f8; color:#7f1d1d; margin-bottom:12px; display:flex; justify-content:space-between; align-items:center;">
                <span><svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/></svg> @ErrorMessage</span>
                <button class="btn-create" @onclick="LoadDashboardData"><svg class="icon-inline" viewBox="0 0 24 24" fill="currentColor"><path d="M12 6v3l4-4-4-4v3c-4.42 0-8 3.58-8 8 0 1.57.46 3.03 1.24 4.26L6.7 14.8c-.45-.83-.7-1.79-.7-2.8 0-3.31 2.69-6 6-6zm6.76 1.74L17.3 9.2c.44.84.7 1.79.7 2.8 0 3.31-2.69 6-6 6v-3l-4 4 4 4v-3c4.42 0 8-3.58 8-8 0-1.57-.46-3.03-1.24-4.26z"/></svg> Retry</button>
            </div>
        }
        else
        {
            <!-- Hero Stats Section -->
            <div class="dashboard-hero">
                <div class="hero-stat">
                    <div class="hero-stat-icon">
                        <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zm-7-2h2V7h-4v2h2z"/></svg>
                    </div>
                    <div class="hero-stat-value">@AvailableRooms</div>
                    <div class="hero-stat-label">Available Rooms</div>
                    <div class="hero-stat-change">
                        @if (AvailableRooms > YesterdayAvailableRooms)
                        {
                            <span style="color: #6ee7b7;">↑ @(AvailableRooms - YesterdayAvailableRooms)</span>
                            <span>vs yesterday</span>
                        }
                        else if (AvailableRooms < YesterdayAvailableRooms)
                        {
                            <span style="color: #fca5a5;">↓ @(YesterdayAvailableRooms - AvailableRooms)</span>
                            <span>vs yesterday</span>
                        }
                        else
                        {
                            <span>No change vs yesterday</span>
                        }
                    </div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-icon">
                        <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                    </div>
                    <div class="hero-stat-value">@ActiveGuests</div>
                    <div class="hero-stat-label">Active Guests</div>
                    <div class="hero-stat-change">
                         @if (ActiveGuests > YesterdayActiveGuests)
                        {
                            <span style="color: #6ee7b7;">↑ @(ActiveGuests - YesterdayActiveGuests)</span>
                            <span>vs yesterday</span>
                        }
                        else if (ActiveGuests < YesterdayActiveGuests)
                        {
                            <span style="color: #fca5a5;">↓ @(YesterdayActiveGuests - ActiveGuests)</span>
                            <span>vs yesterday</span>
                        }
                        else
                        {
                            <span>Same as yesterday</span>
                        }
                    </div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-icon">
                        <svg viewBox="0 0 24 24"><path d="M11.8 10.9c-2.27-.59-3-1.2-3-2.15 0-1.09 1.01-1.85 2.7-1.85 1.78 0 2.44.85 2.5 2.1h2.21c-.07-1.72-1.12-3.3-3.21-3.81V3h-3v2.16c-1.94.42-3.5 1.68-3.5 3.61 0 2.31 1.91 3.46 4.7 4.13 2.5.6 3 1.48 3 2.41 0 .69-.49 1.79-2.7 1.79-2.06 0-2.87-.92-2.98-2.1h-2.2c.12 2.19 1.76 3.42 3.68 3.83V21h3v-2.15c1.95-.37 3.5-1.5 3.5-3.55 0-2.84-2.43-3.81-4.7-4.4z"/></svg>
                    </div>
                    <div class="hero-stat-value">₱@TotalOutstanding.ToString("N0")</div>
                    <div class="hero-stat-label">Outstanding Balance</div>
                    <div class="hero-stat-change">unpaid invoices</div>
                </div>
                <div class="hero-stat">
                    <div class="hero-stat-icon">
                        <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                    </div>
                    <div class="hero-stat-value">@OccupancyRate%</div>
                    <div class="hero-stat-label">Occupancy Rate</div>
                     <div class="hero-stat-change">
                        @if (OccupancyRate > YesterdayOccupancyRate)
                        {
                            <span style="color: #6ee7b7;">↑ @((OccupancyRate - YesterdayOccupancyRate).ToString("0.0"))%</span>
                            <span>vs yesterday</span>
                        }
                        else if (OccupancyRate < YesterdayOccupancyRate)
                        {
                            <span style="color: #fca5a5;">↓ @((YesterdayOccupancyRate - OccupancyRate).ToString("0.0"))%</span>
                            <span>vs yesterday</span>
                        }
                        else
                        {
                            <span>Same as yesterday</span>
                        }
                    </div>
                </div>
            </div>


            <!-- Date Filter -->
            <div class="dashboard-filters">
                <div class="filter-group">
                    <label>Date Range</label>
                    <select value="@SelectedRange" @onchange="OnRangeChanged">
                        <option value="Today">Today</option>
                        <option value="Week">This Week</option>
                        <option value="Month">This Month</option>
                        <option value="Year">This Year</option>
                    </select>
                    <span class="range-note">@RangeLabel</span>
                </div>
            </div>

            <!-- Charts Section -->
            <div class="charts-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px;">
                <!-- Check-In Chart -->
                <div class="premium-card">
                    <div class="premium-card-header">
                        <h3 class="premium-card-title">
                            <span class="card-icon">
                                <svg viewBox="0 0 24 24"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
                            </span>
                            Daily Check-Ins
                        </h3>
                        <span class="range-note">@(RangeStart.Date == RangeEnd.Date ? RangeStart.ToString("MMM dd") : $"{RangeStart:MMM dd} - {RangeEnd:MMM dd}")</span>
                    </div>
                    <div class="premium-card-body">
                        @if (DailyCheckIns.Any())
                        {
                            <div class="chart-container">
                                <canvas id="checkInChart"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-premium">
                                <div class="empty-state-icon">
                                    <svg viewBox="0 0 24 24"><path d="M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z"/></svg>
                                </div>
                                <div class="empty-state-title">No Check-Ins Yet</div>
                                <div class="empty-state-desc">Check-in data will appear here once guests arrive.</div>
                            </div>
                        }
                    </div>
                    @if (RecentCheckInDetails.Any())
                    {
                        <div class="premium-card-footer">
                            <div class="activity-list">
                                @foreach (var detail in RecentCheckInDetails.Take(4))
                                {
                                    <div class="activity-item">
                                        <div class="activity-avatar">@detail.GuestName.Substring(0, 1)</div>
                                        <div class="activity-content">
                                            <div class="activity-title">@detail.GuestName</div>
                                            <div class="activity-meta">@detail.Date.ToString("MMM dd") · Room @(string.IsNullOrWhiteSpace(detail.Rooms) ? "-" : detail.Rooms)</div>
                                        </div>
                                        <span class="activity-badge success">@detail.Status</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                <!-- Attendance Status -->
                <div class="premium-card">
                    <div class="premium-card-header">
                        <h3 class="premium-card-title">
                            <span class="card-icon">
                                <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                            </span>
                            Employee Attendance
                        </h3>
                        <span class="range-note">@(RangeStart.Date == RangeEnd.Date ? RangeStart.ToString("MMM dd") : $"{RangeStart:MMM dd} - {RangeEnd:MMM dd}")</span>
                    </div>
                    <div class="premium-card-body">
                        @if (AttendanceDetails.Any())
                        {
                            <div class="attendance-summary">
                                <div class="status-count present"><span class="dot dot-green"></span><strong>@AttendanceStatus.Present</strong> @(SelectedRange == "Today" ? "Present" : "Days Present")</div>
                                <div class="status-count absent"><span class="dot dot-red"></span><strong>@AttendanceStatus.Absent</strong> @(SelectedRange == "Today" ? "Absent" : "Days Absent")</div>
                                <div class="status-count on-leave"><span class="dot dot-amber"></span><strong>@AttendanceStatus.OnLeave</strong> @(SelectedRange == "Today" ? "On Leave" : "Days On Leave")</div>
                                <div class="status-count late"><span class="dot dot-orange"></span><strong>@AttendanceStatus.Late</strong> @(SelectedRange == "Today" ? "Late" : "Days Late")</div>
                            </div>
                            <div class="activity-list">
                                @foreach (var att in AttendanceDetails.Take(5))
                                {
                                    var statusClass = att.Status?.ToLower() ?? "pending";
                                    var badgeClass = statusClass == "present" ? "success" : (statusClass == "absent" ? "danger" : "warning");
                                    <div class="activity-item" @onclick="() => OpenAttendanceModal(att.EmployeeId)" style="cursor: pointer;">
                                        <div class="activity-avatar">@att.EmployeeName.Substring(0, 1)</div>
                                        <div class="activity-content">
                                            <div class="activity-title">@att.EmployeeName</div>
                                            <div class="activity-meta">ID: @att.EmployeeId · @att.Date.ToString("MMM dd")</div>
                                        </div>
                                        <span class="activity-badge @badgeClass">@att.Status</span>
                                    </div>
                                }
                            </div>
                            @if (AttendanceDetails.Count > 5)
                            {
                                <div style="text-align: center; margin-top: 16px;">
                                    <button class="btn-secondary" @onclick="() => ShowAttendanceModal = true" style="font-size: 0.85rem; padding: 8px 16px; border-radius: 8px;">View All @AttendanceDetails.Count Records →</button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="empty-state-premium">
                                <div class="empty-state-icon">
                                    <svg viewBox="0 0 24 24"><path d="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5z"/></svg>
                                </div>
                                <div class="empty-state-title">No Attendance Data</div>
                                <div class="empty-state-desc">Attendance records will appear here.</div>
                            </div>
                        }
                    </div>
                </div>

                <!-- Inventory Chart -->
                <div class="premium-card dashboard-grid-full">
                    <div class="premium-card-header">
                        <h3 class="premium-card-title">
                            <span class="card-icon">
                                <svg viewBox="0 0 24 24"><path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12zM12 5.5v9l6-4.5z"/></svg>
                            </span>
                            Inventory Overview
                        </h3>
                    </div>
                    <div class="premium-card-body">
                         @if (InventoryByCategory.Any())
                        {
                            <div class="chart-container" style="height: 300px;">
                                <canvas id="inventoryChart"></canvas>
                            </div>
                        }
                        else
                        {
                            <div class="empty-state-premium">
                                <div class="empty-state-title">No Inventory Data</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Attendance Details Modal -->
            @if (ShowAttendanceModal)
            {
                <div class="modal-overlay" @onclick="CloseAttendanceModal">
                    <div class="modal-content" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h2>@(SelectedEmployeeId != null ? $"Attendance Details - Employee {SelectedEmployeeId}" : "All Attendance Records")</h2>
                            <button class="modal-close" @onclick="CloseAttendanceModal">×</button>
                        </div>
                        <div class="modal-body">
                            @if (SelectedEmployeeId != null)
                            {
                                var empRecords = AttendanceDetails.Where(a => a.EmployeeId == SelectedEmployeeId).ToList();
                                @if (empRecords.Any())
                                {
                                    <div class="emp-attendance-header">
                                        <h3>@empRecords.First().EmployeeName</h3>
                                        <p style="color: #64748b;">Employee ID: @SelectedEmployeeId</p>
                                    </div>
                                    <div class="attendance-stats-grid">
                                        <div class="stat-box"><strong>@empRecords.Count(r => r.Status == "Present")</strong> Days Present</div>
                                        <div class="stat-box"><strong>@empRecords.Count(r => r.Status == "Absent")</strong> Days Absent</div>
                                        <div class="stat-box"><strong>@empRecords.Count(r => r.Status == "OnLeave")</strong> Days On Leave</div>
                                        <div class="stat-box"><strong>@empRecords.Count(r => r.Status == "Late")</strong> Days Late</div>
                                    </div>
                                    <table class="modal-attendance-table">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Status</th>
                                                <th>Check In</th>
                                                <th>Check Out</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var record in empRecords)
                                            {
                                                var statusClass = record.Status?.ToLower() ?? "pending";
                                                <tr>
                                                    <td>@record.Date.ToString("MMM dd, yyyy")</td>
                                                    <td><span class="status-badge status-@statusClass">@record.Status</span></td>
                                                    <td>@record.CheckInTime</td>
                                                    <td>@record.CheckOutTime</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                            }
                            else
                            {
                                <table class="modal-attendance-table">
                                    <thead>
                                        <tr>
                                            <th>Employee</th>
                                            <th>ID</th>
                                            <th>Date</th>
                                            <th>Status</th>
                                            <th>Check In</th>
                                            <th>Check Out</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var record in AttendanceDetails)
                                        {
                                            var statusClass = record.Status?.ToLower() ?? "pending";
                                            <tr>
                                                <td style="font-weight: 600;">@record.EmployeeName</td>
                                                <td>@record.EmployeeId</td>
                                                <td>@record.Date.ToString("MMM dd")</td>
                                                <td><span class="status-badge status-@statusClass">@record.Status</span></td>
                                                <td>@record.CheckInTime</td>
                                                <td>@record.CheckOutTime</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </div>
                    </div>
                </div>
            }


        }
    </section>
</div>

@code {
    private bool IsLoaded = false;
    private bool HasError = false;
    private string ErrorMessage = string.Empty;
    private bool ChartsRendered = false;

    private string SelectedRange = "Today";
    private DateTime RangeStart = DateTime.Today;
    private DateTime RangeEnd = DateTime.Today;

    private int AvailableRooms = 0;
    private int TotalRooms = 0;
    private int ActiveGuests = 0;
    private int PendingHousekeepingTasks = 0;
    private decimal TotalOutstanding = 0m;
    private int TodayCheckouts = 0;
    private decimal TodayPayments = 0m;
    private double OccupancyRate = 0d;

    // Comparisons
    private int YesterdayAvailableRooms = 0;
    private int YesterdayActiveGuests = 0;
    private double YesterdayOccupancyRate = 0d;

    // Employee data
    private int TotalEmployees = 0;

    // Cleaning schedule data
    private int RoomsForCleaning = 0;
    private int ActiveCleaningTasks = 0;
    private int AvailableHousekeepers = 0;
    private int MaintenanceRooms = 0;

    // Chart data
    private List<DailyCheckIn> DailyCheckIns = new();
    private List<CheckInDetail> RecentCheckInDetails = new();
    private List<InventoryCategoryData> InventoryByCategory = new();
    private AttendanceStatusData AttendanceStatus = new();
    private List<AttendanceDetail> AttendanceDetails = new();
    private List<InventoryItem> LowStockItems = new();
    
    private bool ShowAttendanceModal = false;
    private string? SelectedEmployeeId = null;

    protected override async Task OnInitializedAsync()
    {
        // Only Administrator may access dashboard. Redirect others.
        if (UserSession?.Role != "Administrator")
        {
            Navigation.NavigateTo("/", true);
            return;
        }

        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            IsLoaded = false;
            HasError = false;
            ChartsRendered = false;

            UpdateRangeDates();

            using var context = await DbFactory.CreateDbContextAsync();

            TotalRooms = await context.Rooms.CountAsync();
            AvailableRooms = await context.Rooms.CountAsync(r => r.Status == "Available");

            var snapshotDate = DateOnly.FromDateTime(RangeEnd);
            ActiveGuests = await context.Reservations.CountAsync(r => r.CheckInDate <= snapshotDate && (r.CheckOutDate >= snapshotDate));

            PendingHousekeepingTasks = await context.CleaningTasks.CountAsync(t => t.Status == "Pending");

            TotalOutstanding = await context.Bills.Where(b => b.BalanceDue != null).SumAsync(b => (decimal?)b.BalanceDue) ?? 0m;

            var rangeStartDateOnly = DateOnly.FromDateTime(RangeStart);
            var rangeEndDateOnly = DateOnly.FromDateTime(RangeEnd);

            TodayCheckouts = await context.Reservations.CountAsync(r => r.CheckOutDate >= rangeStartDateOnly && r.CheckOutDate <= rangeEndDateOnly);

            var rangeStartDateTime = RangeStart.Date;
            var rangeEndDateTime = RangeEnd.Date.AddDays(1);
            TodayPayments = await context.Payments
                .Where(p => p.PaymentDate >= rangeStartDateTime && p.PaymentDate < rangeEndDateTime)
                .SumAsync(p => (decimal?)p.Amount) ?? 0m;

            OccupancyRate = TotalRooms == 0 ? 0 : Math.Round((double)(TotalRooms - AvailableRooms) / TotalRooms * 100, 1);

            // Fetch Comparisons (Assuming "Yesterday" for simplicity when "Today" is selected)
            // If Range is Year/Month, comparisons could be Last Year/Month, but let's stick to previous day relative to snapshot for now
            // or if Range is "Today", compare to "Yesterday".
            
            DateOnly comparisonDate;
            if (SelectedRange == "Today")
                comparisonDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-1));
            else if (SelectedRange == "Week")
                comparisonDate = DateOnly.FromDateTime(DateTime.Today.AddDays(-7)); // Compare to last week
            else 
                comparisonDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(-1)); // Compare to last month

            // Comparison Metrics
            var yesterdaySnapshotDate = comparisonDate;
            // Note: This is an approximation. Strict historical room availability isn't stored.
            // We use Reservation data to infer historical occupancy.
            var comparisonOccupied = await context.Reservations.CountAsync(r => r.CheckInDate <= yesterdaySnapshotDate && r.CheckOutDate > yesterdaySnapshotDate);
            YesterdayAvailableRooms = TotalRooms - comparisonOccupied; // Rough estimate assuming total rooms constant
            YesterdayActiveGuests = comparisonOccupied; // Rough estimate
            YesterdayOccupancyRate = TotalRooms == 0 ? 0 : Math.Round((double)comparisonOccupied / TotalRooms * 100, 1);

            // Load employee data
            await LoadEmployeeData(context);

            // Load cleaning schedule data
            await LoadCleaningData();

            // Load chart data
            await LoadChartData(context);

            IsLoaded = true;
            StateHasChanged();

            await RenderCharts();
        }
        catch (Exception ex)
        {
            HasError = true;
            ErrorMessage = ex.Message;
            IsLoaded = true;
            await JSRuntime.InvokeVoidAsync("alert", $"Dashboard load error: {ex.Message}");
        }
    }

    private async Task LoadEmployeeData(HestiaLinkContext context)
    {
        try
        {
            var todayDate = DateOnly.FromDateTime(RangeEnd);
            
            // Total active employees
            TotalEmployees = await context.Employees.CountAsync(e => e.Status == "Active");

            // Get today's schedules
            var todaySchedules = await context.Schedules
                .Where(s => s.ScheduleDate == todayDate && s.IsActive == true)
                .ToListAsync();

            var scheduleIds = todaySchedules.Select(s => s.ScheduleId).ToList();

        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading employee data: {ex.Message}");
        }
    }

    private async Task LoadCleaningData()
    {
        try
        {
            // Get rooms for cleaning
            var roomsForCleaningList = await HousekeepingService.GetRoomsForCleaningAsync();
            RoomsForCleaning = roomsForCleaningList.Count;

            // Get active tasks
            var activeTasksList = await HousekeepingService.GetActiveTasksAsync();
            ActiveCleaningTasks = activeTasksList.Count;

            // Get available housekeepers
            var availableHousekeepersList = await HousekeepingService.GetAvailableHousekeepersAsync();
            AvailableHousekeepers = availableHousekeepersList.Count;

            // Get rooms under maintenance
            var maintenanceRoomsList = await HousekeepingService.GetRoomsUnderMaintenanceAsync();
            MaintenanceRooms = maintenanceRoomsList.Count;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading cleaning data: {ex.Message}");
        }
    }

    private async Task LoadChartData(HestiaLinkContext context)
    {
        try
        {
            var today = DateOnly.FromDateTime(RangeEnd);
            var rangeStartDate = DateOnly.FromDateTime(RangeStart);
            var rangeEndDate = DateOnly.FromDateTime(RangeEnd);

            // Pull all check-ins in a single range query to reuse for chart and details
            var checkInRange = await context.Reservations
                .Include(r => r.Guest)
                .Include(r => r.ReservedRooms)
                    .ThenInclude(rr => rr.Room)
                .Where(r => r.CheckInDate >= rangeStartDate && r.CheckInDate <= rangeEndDate)
                .ToListAsync();

            // 1. Daily Check-Ins (Selected Range)
            DailyCheckIns.Clear();
            var totalDays = (rangeEndDate.ToDateTime(TimeOnly.MinValue) - rangeStartDate.ToDateTime(TimeOnly.MinValue)).Days + 1;
            for (int i = 0; i < totalDays; i++)
            {
                var date = rangeStartDate.AddDays(i);
                var checkInCount = checkInRange.Count(r => r.CheckInDate == date);
                DailyCheckIns.Add(new DailyCheckIn
                {
                    Date = date,
                    Count = checkInCount
                });
            }

            // Build recent check-in detail list (latest first)
            RecentCheckInDetails = checkInRange
                .OrderByDescending(r => r.CheckInDate)
                .ThenByDescending(r => r.CreatedDate ?? DateTime.MinValue)
                .Take(8)
                .Select(r => new CheckInDetail
                {
                    Date = r.CheckInDate,
                    GuestName = r.Guest != null ? $"{r.Guest.FirstName} {r.Guest.LastName}" : "Walk-in",
                    Rooms = string.Join(", ", r.ReservedRooms.Select(rr => rr.Room?.RoomNumber ?? "—")),
                    Status = string.IsNullOrWhiteSpace(r.Status) ? "Confirmed" : r.Status
                })
                .ToList();

            // 2. Inventory by Category
            InventoryByCategory.Clear();
            var inventoryItems = await context.InventoryItems
                .Where(i => i.IsActive == true)
                .ToListAsync();
            
            var categoryGroups = inventoryItems
                .GroupBy(i => i.Category)
                .Select(g => new InventoryCategoryData
                {
                    Category = g.Key,
                    TotalStock = g.Sum(i => i.CurrentStock ?? 0),
                    TotalValue = g.Sum(i => (i.CurrentStock ?? 0) * i.UnitCost),
                    ItemCount = g.Count()
                })
                .OrderByDescending(c => c.TotalStock)
                .Take(6)
                .ToList();
            
            InventoryByCategory = categoryGroups;

            // Low stock items for restock info
            LowStockItems = inventoryItems
                .Where(i => (i.CurrentStock ?? 0) <= (i.ReorderPoint ?? 0))
                .OrderBy(i => i.CurrentStock ?? 0)
                .ToList();

            // 3. Attendance Status (Range-based)
            var rangeStartDateOnly = DateOnly.FromDateTime(RangeStart);
            var rangeEndDateOnly = DateOnly.FromDateTime(RangeEnd);
            
            var rangeAttendances = await context.Attendances
                .Include(a => a.Schedule)
                    .ThenInclude(s => s.Employee)
                .Where(a => a.AttendanceDate >= rangeStartDateOnly && a.AttendanceDate <= rangeEndDateOnly)
                .ToListAsync();

            AttendanceStatus = new AttendanceStatusData
            {
                Present = rangeAttendances.Count(a => a.AttendanceStatus == "Present"),
                Absent = rangeAttendances.Count(a => a.AttendanceStatus == "Absent"),
                OnLeave = rangeAttendances.Count(a => a.AttendanceStatus == "OnLeave"),
                Late = rangeAttendances.Count(a => a.AttendanceStatus == "Late" || (a.ActualCheckIn.HasValue && a.Schedule != null && a.ActualCheckIn.Value.TimeOfDay > a.Schedule.ScheduledStart.ToTimeSpan().Add(TimeSpan.FromMinutes(15)))),
                TotalEmployees = await context.Employees.CountAsync(e => e.Status == "Active")
            };

            // Build attendance detail list (latest first)
            AttendanceDetails = rangeAttendances
                .OrderByDescending(a => a.AttendanceDate)
                .Select(a => new AttendanceDetail
                {
                    EmployeeId = a.Schedule?.Employee?.EmployeeId.ToString() ?? "—",
                    EmployeeName = a.Schedule?.Employee != null ? $"{a.Schedule.Employee.FirstName} {a.Schedule.Employee.LastName}" : "Unknown",
                    Status = a.AttendanceStatus ?? "Pending",
                    Date = a.AttendanceDate,
                    CheckInTime = a.ActualCheckIn?.ToString("hh:mm tt") ?? "—",
                    CheckOutTime = a.ActualCheckOut?.ToString("hh:mm tt") ?? "—"
                })
                .ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading chart data: {ex.Message}");
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            if (!IsLoaded || HasError || ChartsRendered)
                return;

            // Wait briefly for DOM to be ready
            await Task.Delay(300);
            StateHasChanged();

            // 1. Check-In Line Chart
            if (DailyCheckIns.Any())
            {
                var checkInLabels = DailyCheckIns.Select(d => d.Date.ToString("MMM dd")).ToArray();
                var checkInData = DailyCheckIns.Select(d => d.Count).ToArray();
                await JSRuntime.InvokeVoidAsync("chartHelper.renderLineChart", 
                    "checkInChart", 
                    checkInLabels, 
                    checkInData, 
                    "Check-Ins", 
                    "#0f766e", 
                    "rgba(15, 118, 110, 0.1)");
            }

            // 2. Inventory Bar Chart
            if (InventoryByCategory.Any())
            {
                var inventoryLabels = InventoryByCategory.Select(i => i.Category).ToArray();
                var inventoryData = InventoryByCategory.Select(i => (double)i.TotalStock).ToArray();
                var inventoryColors = new[] { "#0d9488", "#0f766e", "#115e59", "#134e4a", "#14b8a6", "#2dd4bf" };
                await JSRuntime.InvokeVoidAsync("chartHelper.renderBarChart", 
                    "inventoryChart", 
                    inventoryLabels, 
                    inventoryData, 
                    inventoryColors, 
                    "Stock Quantity");
            }

            // 3. Attendance list data already loaded in AttendanceDetails
            ChartsRendered = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
            await JSRuntime.InvokeVoidAsync("console.error", $"Chart rendering error: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderCharts();
        }
    }

    // Data classes
    private class DailyCheckIn
    {
        public DateOnly Date { get; set; }
        public int Count { get; set; }
    }

    private class CheckInDetail
    {
        public DateOnly Date { get; set; }
        public string GuestName { get; set; } = string.Empty;
        public string Rooms { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
    }

    private class AttendanceDetail
    {
        public string EmployeeId { get; set; } = string.Empty;
        public string EmployeeName { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public DateOnly Date { get; set; }
        public string CheckInTime { get; set; } = string.Empty;
        public string CheckOutTime { get; set; } = string.Empty;
    }

    private class InventoryCategoryData
    {
        public string Category { get; set; } = string.Empty;
        public int TotalStock { get; set; }
        public decimal TotalValue { get; set; }
        public int ItemCount { get; set; }
    }

    private class AttendanceStatusData
    {
        public int Present { get; set; }
        public int Absent { get; set; }
        public int OnLeave { get; set; }
        public int Late { get; set; }
        public int TotalEmployees { get; set; }
    }

    private void UpdateRangeDates()
    {
        var today = DateTime.Today;
        SelectedRange = string.IsNullOrWhiteSpace(SelectedRange) ? "Today" : SelectedRange;

        switch (SelectedRange)
        {
            case "Week":
                RangeEnd = today;
                RangeStart = today.AddDays(-6);
                break;
            case "Month":
                RangeEnd = today;
                RangeStart = new DateTime(today.Year, today.Month, 1);
                break;
            case "Year":
                RangeEnd = today;
                RangeStart = new DateTime(today.Year, 1, 1);
                break;
            default:
                RangeEnd = today;
                RangeStart = today;
                SelectedRange = "Today";
                break;
        }
    }

    private async Task OnRangeChanged(ChangeEventArgs e)
    {
        SelectedRange = e.Value?.ToString() ?? "Today";
        UpdateRangeDates();
        await LoadDashboardData();
    }

    private string RangeLabel => RangeStart.Date == RangeEnd.Date
        ? RangeStart.ToString("MMM dd, yyyy")
        : $"{RangeStart:MMM dd, yyyy} - {RangeEnd:MMM dd, yyyy}";

    private void OpenAttendanceModal(string employeeId)
    {
        SelectedEmployeeId = employeeId;
        ShowAttendanceModal = true;
    }

    private void CloseAttendanceModal()
    {
        ShowAttendanceModal = false;
        SelectedEmployeeId = null;
    }
}

